---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'pt-BR' | 'en' | 'ru';
  canonicalPath?: string;
}

const { 
  title = 'Natalia Fernandes English | Destrave seu Inglês', 
  description = 'Um programa prático para adultos que querem voltar a falar inglês com mais confiança.',
  lang = 'pt-BR',
  canonicalPath = Astro.url.pathname
} = Astro.props;

const siteUrl = 'https://nfenglish.com.br';

// Strip language prefixes (/en or /ru) to get base path
const cleanPath = canonicalPath.replace(/^\/(en|ru)(\/|$)/, '/');
const normalizedPath = cleanPath === '' ? '/' : cleanPath;

const ptPath = normalizedPath;
const enPath = normalizedPath === '/' ? '/en' : `/en${normalizedPath}`;
const ruPath = normalizedPath === '/' ? '/ru' : `/ru${normalizedPath}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5PC9DR5N');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..700&family=Fraunces:ital,opsz,wght@0,9..144,600..700;1,9..144,600..700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..700&family=Fraunces:ital,opsz,wght@0,9..144,600..700;1,9..144,600..700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..700&family=Fraunces:ital,opsz,wght@0,9..144,600..700;1,9..144,600..700&display=swap" />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/Nath.jpg`} />
    <meta property="og:url" content={`${siteUrl}${canonicalPath}`} />
    
    <!-- Alternate languages (SEO) -->
    <link rel="alternate" hreflang="pt-BR" href={`${siteUrl}${ptPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="ru" href={`${siteUrl}${ruPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${ptPath}`} />
    
    <meta name="theme-color" content="#35483d" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5PC9DR5N"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
