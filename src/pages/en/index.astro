---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const whatsappDiagnostic = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20to%20talk%20about%20a%20tailored%20English%20plan.';
const whatsappMentoring = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20am%20interested%20in%201:1%20Executive%20Mentoring%20sessions.';
const whatsappCorporate = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20information%20about%20corporate%20in-company%20English%20training.';

const pillars = [
  {
    num: '01',
    title: 'Deep Individual Diagnostic',
    desc: 'Before your first class, we analyze your history with the language, your main speaking barriers, and your immediate career goals to design the ideal path.'
  },
  {
    num: '02',
    title: 'Affinity Map & Real Life',
    desc: 'Your professional routine, industry vocabulary, meetings, travels, and personal interests become the core class material — zero generic textbook filler.'
  },
  {
    num: '03',
    title: 'Psychological Safety & Support',
    desc: 'We cultivate an environment where mistakes are treated as natural adjustment tools. You speak gradually, free from fear of judgment or awkward interruptions.'
  },
  {
    num: '04',
    title: 'Built for Busy Professionals',
    desc: 'A flexible methodology with smart scheduling and actionable missions, specifically designed for adults with demanding careers and limited time.'
  }
];

const faqs = [
  {
    q: 'How does personalization work in practice?',
    a: 'After an initial assessment of your profile and goals, we build your syllabus around topics, vocabulary, and situations directly relevant to your daily routine — whether for business meetings, international interviews, travel, or networking. No rigid page-by-page textbook following.'
  },
  {
    q: 'Who are NF English programs designed for?',
    a: 'Our programs are exclusively tailored for adults and working professionals: people who have studied English before or understand the basics, but freeze when speaking and need confidence to communicate in their career and personal life.'
  },
  {
    q: 'What is the difference between 1:1 Mentoring and the Unlock Program?',
    a: '1:1 Mentoring is an exclusive private track with flexible scheduling and 100% custom focus for urgent, high-stakes goals. The Unlock Your English Program (Destrave) is an 8-week immersive group experience in small cohorts, designed to unlock speaking in a supportive collective environment.'
  },
  {
    q: 'How do corporate In-Company trainings work?',
    a: 'We develop custom training programs for corporate teams and leaders, incorporating company workflows, industry-specific jargon, and practical business scenarios (presentations, negotiations, emails). We have delivered training for global brands like Yamaha, Eaton, and Mahle.'
  },
  {
    q: 'Are classes online or in person?',
    a: 'All our solutions are conducted 100% live online, using modern interactive tools and close teacher guidance, allowing you to join from anywhere with complete convenience.'
  },
  {
    q: 'How do I take the first step?',
    a: 'Simply click any button on this page to chat directly with Natalia or our team on WhatsApp. We will conduct a quick diagnostic of your current stage and recommend the best format for you.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Personalized English Coaching for Adults & Companies" 
  description="Premium personalized English education focusing on speaking confidence, psychological safety, and 15 years of authority. 1:1 mentoring, group programs, and corporate training."
  lang="en"
>
  <div class="page" id="top">
    <Header mode="institutional" lang="en" />
    
    <main>
      <!-- INSTITUTIONAL HERO -->
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow"><span class="dot"></span> Excellence & Personalization</div>
            <h1>English that adapts to your life, your career, and your rhythm.</h1>
            <p class="hero-copy">
              No generic formulas or rigid classrooms. For 15 years, we have been helping adults transform passive knowledge into confident, natural speaking through tailored coaching.
            </p>
            <div class="hero-actions">
              <a class="button" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
                Discuss Your Plan on WhatsApp
              </a>
              <a class="button secondary" href="#solutions">
                Explore Programs
              </a>
            </div>
            <p class="microcopy">Consultative and welcoming conversation via WhatsApp. No obligations.</p>
            <div class="hero-proof">
              <span class="pill">15+ years experience</span>
              <span class="pill">100% adult-focused</span>
              <span class="pill">Corporate expertise</span>
              <span class="pill">1:1 and group tracks</span>
            </div>
          </div>

          <div class="hero-image-wrapper">
            <div class="hero-circle-frame">
              <img src="/Nath.jpg" alt="Natalia Fernandes, founder of NF English" />
            </div>
            <div class="floating-note">
              <strong>Real Personalization:</strong>
              <p>Your profession, your interests, and your real challenges become your class curriculum.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PROOF BAR -->
      <div class="proof">
        <div class="container proof-row" aria-label="NF English credentials and key highlights">
          <div class="proof-item">
            <b>15+ Years</b>
            <span>dedicated exclusively to teaching adult learners</span>
          </div>
          <div class="proof-item">
            <b>100% Tailored</b>
            <span>strategy customized to your schedule and goals</span>
          </div>
          <div class="proof-item">
            <b>In-Company</b>
            <span>corporate trainings for major multinational brands</span>
          </div>
          <div class="proof-item">
            <b>Speaking First</b>
            <span>psychological safety to hold real conversations</span>
          </div>
        </div>
      </div>

      <!-- CORPORATE STRIP -->
      <div class="corporate-strip" id="corporate">
        <div class="container corporate-inner">
          <span class="corporate-label">Trusted by leading professionals and global corporations:</span>
          <div class="corporate-logos">
            <span class="corp-badge">YAMAHA</span>
            <span class="corp-badge">EATON</span>
            <span class="corp-badge">MAHLE</span>
            <span class="corp-badge">+ Executives & Leaders</span>
          </div>
        </div>
      </div>

      <!-- THE PROBLEM: TRADITIONAL VS PERSONALIZED -->
      <section class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> The Traditional Method Problem</div>
            <h2>Why one-size-fits-all courses fail busy adults</h2>
            <p>
              Traditional language schools push everyone through the same mechanical assembly line. The result is frustration, wasted time, and the false feeling that you "just aren't good at languages."
            </p>
          </div>

          <div class="compare-grid">
            <div class="compare-box traditional">
              <h3>Generic Shelf Courses</h3>
              <p class="muted">The rigid model that ignores the reality of adult learners:</p>
              <ul class="compare-list traditional">
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Standardized textbooks with fake dialogues disconnected from your daily work.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Crowded classes with mixed levels, causing anxiety and minimal speaking time.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Excessive focus on memorizing theoretical grammar without practical usage.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Harsh corrections that destroy spontaneity and create mental blocks.</span>
                </li>
              </ul>
            </div>

            <div class="compare-box nf">
              <span class="compare-badge">The NF English Difference</span>
              <h3>Learning with True Personalization</h3>
              <p class="muted">A methodology that molds around who you are and what you need:</p>
              <ul class="compare-list">
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Living content:</strong> your career, projects, travel, and personal stories become class topics.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Psychological safety:</strong> a warm atmosphere where mistakes are natural stepping stones to fluency.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Immediate relevance:</strong> learn vocabulary and phrases you will use the very same day at work.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Close guidance:</strong> mentorship from an educator who understands busy schedules.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 4 PILLARS -->
      <section id="personalization">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow sage"><span class="dot"></span> Exclusive Methodology</div>
            <h2>The 4 Pillars of Personalized Learning</h2>
            <p>Discover the pedagogical framework that ensures every minute of class has direct relevance for you.</p>
          </div>

          <div class="pillars-4">
            {pillars.map((pillar) => (
              <div class="pillar-card">
                <div class="pillar-num">{pillar.num}</div>
                <div class="pillar-content">
                  <h3>{pillar.title}</h3>
                  <p>{pillar.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SOLUTIONS & FORMATS -->
      <section id="solutions" class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> Our Solutions</div>
            <h2>The right format for your goals and availability</h2>
            <p>From 1:1 executive mentoring to group immersion and corporate trainings, we offer a solution tailored for you.</p>
          </div>

          <div class="solutions-grid">
            <!-- 1:1 Mentoring -->
            <div class="solution-card">
              <div>
                <div class="solution-tag">Individual & Executive</div>
                <h3>1:1 Tailored Mentoring</h3>
                <p class="solution-desc">
                  Exclusive private coaching 100% focused on your career milestones, high-stakes meetings, international presentations, or relocation.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> Fully individualized pedagogical roadmap</li>
                  <li><span class="chk">✓</span> Rehearsals for real business scenarios</li>
                  <li><span class="chk">✓</span> Total schedule and pacing flexibility</li>
                  <li><span class="chk">✓</span> Continuous feedback on pronunciation and flow</li>
                </ul>
              </div>
              <a class="button secondary" href={whatsappMentoring} target="_blank" rel="noreferrer">
                Inquire About 1:1 Mentoring
              </a>
            </div>

            <!-- Destrave Group (Featured) -->
            <div class="solution-card featured">
              <span class="solution-featured-tag">Group Program</span>
              <div>
                <div class="solution-tag">Selected Cohorts</div>
                <h3>Unlock Your English ("Destrave")</h3>
                <p class="solution-desc">
                  An 8-week practical program for adults who have studied English before but freeze when speaking. Supportive practice and real vocabulary.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> 8 live online sessions in small cohorts</li>
                  <li><span class="chk">✓</span> 24 targeted recorded video lessons</li>
                  <li><span class="chk">✓</span> Personal Affinity Map & Phrase Bank</li>
                  <li><span class="chk">✓</span> 10–15 min final conversation assessment</li>
                </ul>
              </div>
              <a class="button" href="/en/destrave">
                Explore Program Details ↗
              </a>
            </div>

            <!-- Corporate -->
            <div class="solution-card">
              <div>
                <div class="solution-tag">For Companies & Teams</div>
                <h3>In-Company Training</h3>
                <p class="solution-desc">
                  Customized corporate programs for teams and leaders who need agile, assertive, and confident communication in global business.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> Corporate language proficiency assessment</li>
                  <li><span class="chk">✓</span> Content aligned to industry jargon and company workflows</li>
                  <li><span class="chk">✓</span> Proven track record with Yamaha, Eaton, Mahle</li>
                  <li><span class="chk">✓</span> Regular reporting on attendance and evolution</li>
                </ul>
              </div>
              <a class="button secondary" href={whatsappCorporate} target="_blank" rel="noreferrer">
                Corporate Solutions
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ABOUT NATALIA FERNANDES -->
      <section id="about">
        <div class="container teacher">
          <div class="teacher-photo">
            <img src="/Nath.jpg" alt="Teacher Natalia Fernandes, founder of NF English" />
          </div>
          <div>
            <div class="section-head">
              <div class="eyebrow"><span class="dot"></span> Founder & Head Coach</div>
              <h2>Meet Natalia Fernandes</h2>
              <p>
                With over 15 years dedicated to English education, Natalia has built a career focused on adult learners — guiding professionals with past classroom anxieties and global corporate executives to achieve speaking independence.
              </p>
            </div>

            <div class="grid cred-grid">
              <div class="cred">
                <b>15+ Years</b>
                <span>of classroom and 1:1 executive mentoring</span>
              </div>
              <div class="cred">
                <b>Adult Specialist</b>
                <span>expert in speaking confidence & real communication</span>
              </div>
              <div class="cred">
                <b>In-Company</b>
                <span>training programs for global industrial leaders</span>
              </div>
            </div>

            <div class="teacher-manifesto">
              "Fluency isn't about speaking flawlessly or faking a native accent. Fluency is the freedom to express your ideas clearly, defend your perspective, and participate in the world without fear."
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> Questions & Answers</div>
            <h2>Frequently Asked Questions</h2>
            <p>Clear answers about our methodology, programs, and how to get started.</p>
          </div>

          <div class="grid faq-grid">
            {faqs.map((faq) => (
              <details>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="final-cta">
        <div class="container final-grid">
          <div>
            <h2>Ready to unlock your English with a plan tailored to you?</h2>
            <p>
              Chat directly with our team on WhatsApp to ask questions, schedule a pedagogical diagnostic, or find the ideal program for your goals.
            </p>
          </div>
          <a class="button gold" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
            Chat on WhatsApp
          </a>
        </div>
      </section>
    </main>

    <!-- MOBILE FLOATING CTA -->
    <div class="mobile-cta">
      <a class="button" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
        Chat on WhatsApp
      </a>
    </div>

    <!-- FOOTER -->
    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <div class="brand" style="margin-bottom: 14px;">
              <span class="brand-mark">NF</span>
              <span>Natalia Fernandes English</span>
            </div>
            <p class="muted">
              High-excellence personalized English coaching for adults, leaders, and companies. Transforming passive knowledge into confident, real-world communication with warmth and safety.
            </p>
          </div>

          <div class="footer-col">
            <strong>Solutions</strong>
            <ul class="footer-links">
              <li><a href={whatsappMentoring} target="_blank" rel="noreferrer">1:1 Executive Mentoring</a></li>
              <li><a href="/en/destrave">Unlock Your English Program</a></li>
              <li><a href={whatsappCorporate} target="_blank" rel="noreferrer">In-Company Training</a></li>
              <li><a href="#personalization">Methodology & Pillars</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <strong>Contact & Support</strong>
            <ul class="footer-links">
              <li><a href={whatsappDiagnostic} target="_blank" rel="noreferrer">WhatsApp: +55 (11) 96716-5564</a></li>
              <li><a href="#top">Back to top ↑</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div>© {new Date().getFullYear()} Natalia Fernandes English. All rights reserved.</div>
          <div>nfenglish.com.br</div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
