---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import CorporateStrip from '../../components/CorporateStrip.astro';
import ComparisonSection from '../../components/ComparisonSection.astro';
import PillarsSection from '../../components/PillarsSection.astro';
import SolutionsSection from '../../components/SolutionsSection.astro';
import TeacherSection from '../../components/TeacherSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';

const whatsappDiagnostic = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20to%20talk%20about%20a%20tailored%20English%20plan.';
const whatsappMentoring = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20am%20interested%20in%201:1%20Executive%20Mentoring%20sessions.';
const whatsappKids = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20to%20learn%20more%20about%20English%20lessons%20for%20kids%20and%20expat%20families.';
const whatsappCorporate = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20information%20about%20corporate%20in-company%20English%20training.';

const pillars = [
  {
    num: '01',
    title: 'Deep Individual Diagnostic',
    desc: 'Before the first class, we analyze background history with the language, emotional speaking barriers, and immediate goals to design the ideal path.'
  },
  {
    num: '02',
    title: 'Affinity Map & Real Life',
    desc: 'Your professional routine, personal interests, travels, or a child’s unique world become the core class material — zero generic textbook filler.'
  },
  {
    num: '03',
    title: 'Psychological Safety & Support',
    desc: 'We cultivate an environment where mistakes are treated as natural adjustment tools. You speak gradually, free from fear of judgment or awkward interruptions.'
  },
  {
    num: '04',
    title: 'Tailored Pacing & Methodology',
    desc: 'A flexible methodology with smart scheduling, actionable missions, and age-adjusted pacing — whether for busy executives or children who thrive on playful engagement.'
  }
];

const solutions = [
  {
    tag: 'Individual & Executive',
    title: '1:1 Custom Mentoring',
    desc: 'Private executive coaching 100% focused on your career goals, international meetings, interviews, or high-stakes business presentations.',
    features: [
      'Personalized learning roadmaps',
      'Simulations tailored to real work challenges',
      'Flexible scheduling and pacing',
      'Continuous pronunciation and fluency feedback'
    ],
    ctaText: 'Inquire About 1:1 Mentoring',
    ctaHref: whatsappMentoring,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'Select Cohorts',
    isFeatured: true,
    featuredTag: 'Group Program',
    title: 'Unlock Your English',
    desc: 'An 8-week practical immersive track for adults who understand English but freeze when speaking. Supportive, psychologically safe environment.',
    features: [
      '8 live interactive online sessions',
      '24 bite-sized on-demand modules',
      'Affinity Map & Personal Phrase Bank',
      'Final 1-on-1 progress conversation'
    ],
    ctaText: 'Explore Program Details ↗',
    ctaHref: '/en/destrave'
  },
  {
    tag: 'Kids, Teens & Expats',
    title: 'Kids & Teens Lessons (7+)',
    desc: 'Warm, engaging online coaching for children and youth aged 7+. Ideal for natural fluency development and international expat families.',
    features: [
      'Playful, stress-free methodology with zero rote memorization',
      'Focus on spontaneous speaking and real-world vocabulary',
      'Proven track record with expat families (Brazil, Dubai, globally)',
      '100% live online classes with close teacher mentorship'
    ],
    ctaText: 'Inquire About Kids Lessons',
    ctaHref: whatsappKids,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'For Teams & Corporations',
    title: 'In-Company Training',
    desc: 'Tailored corporate language solutions for teams and executives needing confident, clear communication in global business settings.',
    features: [
      'Corporate proficiency assessments',
      'Syllabus aligned with company workflows & jargon',
      'Proven track record with Yamaha, Eaton, Mahle',
      'Regular engagement and progress reporting'
    ],
    ctaText: 'Corporate Solutions',
    ctaHref: whatsappCorporate,
    ctaClass: 'secondary',
    isExternal: true
  }
];

const faqs = [
  {
    q: 'How does personalization work in practice?',
    a: 'After an initial assessment of your profile and goals, we build your syllabus around topics, vocabulary, and situations directly relevant to your daily routine or your child’s learning stage — whether for business meetings, international school environments, travel, or networking. No rigid page-by-page textbook following.'
  },
  {
    q: 'Who are NF English programs designed for?',
    a: 'We teach adults and working professionals who need to overcome speaking barriers for career and personal growth, as well as children and teens (from age 7) and expat families (in Brazil, Dubai, and worldwide) seeking top-tier personalized coaching.'
  },
  {
    q: 'How do lessons for kids (7+) and expat families abroad work?',
    a: 'Classes for children combine interactive storytelling, gamified dynamics, and contextual conversations to build genuine fluency and confidence early on without rigid textbooks. For international students and expat families abroad (such as in Dubai or Europe), lessons are conducted 100% live online with flexible timezone scheduling.'
  },
  {
    q: 'What is the difference between 1:1 Mentoring and the Unlock Program?',
    a: '1:1 Mentoring is an exclusive private track with flexible scheduling and 100% custom focus for urgent, high-stakes goals. The Unlock Your English Program (Destrave) is an 8-week immersive group experience in small cohorts, designed for adults to unlock speaking in a supportive collective environment.'
  },
  {
    q: 'How do corporate In-Company trainings work?',
    a: 'We develop custom training programs for corporate teams and leaders, incorporating company workflows, industry-specific jargon, and practical business scenarios (presentations, negotiations, emails). We have delivered training for global brands like Yamaha, Eaton, and Mahle.'
  },
  {
    q: 'Are classes online or in person?',
    a: 'All our solutions are conducted 100% live online, using modern interactive tools and close teacher guidance, allowing you or your children to join from anywhere in Brazil or across the globe with complete convenience.'
  },
  {
    q: 'How do I take the first step?',
    a: 'Simply click any button on this page to chat directly with Natalia or our team on WhatsApp. We will conduct a quick diagnostic of your current stage (or your child’s) and recommend the best format for you.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Tailored English Coaching for Adults, Kids (7+) & Companies" 
  description="Premium personalized English education focusing on speaking confidence, psychological safety, and 15 years of authority. 1:1 sessions for adults & kids (7+), group tracks, and corporate training."
  lang="en"
>
  <div class="page" id="top">
    <Header mode="institutional" lang="en" />
    
    <main>
      <!-- HERO -->
      <Hero
        title="English that adapts to your life, your career, and your family."
        description="No generic formulas or rigid classrooms. For 15 years, we have helped adults, working professionals, and children aged 7+ transform passive knowledge into confident, natural communication."
        primaryAction={{ text: 'Discuss Your Plan on WhatsApp', href: whatsappDiagnostic, isExternal: true }}
        secondaryAction={{ text: 'Explore Programs', href: '#solutions' }}
        microcopy="Consultative and welcoming conversation via WhatsApp. No obligations."
        pills={['15+ years experience', 'Adults, Teens & Kids (7+)', 'Students in Brazil & Worldwide', '1:1 & Group Tracks']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, founder of NF English"
        floatingNoteTitle="Genuine Personalization:"
        floatingNoteText="Your classes are built around your real life, interests, and actual day-to-day challenges."
      />

      <!-- METRICS -->
      <ProofBar
        ariaLabel="NF English Credentials & Highlights"
        items={[
          { value: '15+ Years', label: 'of dedicated personalized and supportive language teaching' },
          { value: '100% Tailored', label: 'strategies built around your goals, age, and schedule' },
          { value: 'Brazil & Global', label: 'students in Dubai, Florianópolis, and international hubs' },
          { value: 'Speaking Focus', label: 'psychological safety to communicate in the real world' }
        ]}
      />

      <!-- CORPORATE -->
      <div id="corporate">
        <CorporateStrip
          label="Trusted by global executives and multinational corporations:"
          extraBadge="+ C-Level Leaders"
        />
      </div>

      <!-- COMPARISON -->
      <ComparisonSection
        id="personalization"
        isBand={true}
        eyebrow="The Flaw of Traditional Teaching"
        title="Why generic courses fail in real life"
        description="Most traditional schools put every student on the same assembly line. The result is frustration, lost time, and the false belief that you 'just are not good at languages'."
        traditionalTitle="Off-the-Shelf Traditional Schools"
        traditionalDesc="The rigid model that ignores individual learners:"
        traditionalItems={[
          'Standardized textbooks filled with artificial dialogues unrelated to your life.',
          'Overcrowded mixed-level classes fostering anxiety and minimal speaking time.',
          'Obsessive focus on rote grammar rules without immediate practical application.',
          'Harsh correction methods that stifle spontaneity and create speaking blocks.'
        ]}
        nfTitle="Real Personalization That Works"
        nfDesc="A methodology shaped entirely around who you are and what you need:"
        nfBadge="The NF English Difference"
        nfItems={[
          'Living content: your career, projects, travels, family, or personal interests become the class material.',
          'Psychological safety: a supportive space where mistakes are treated as natural learning cues.',
          'Immediate relevance: acquire expressions and vocabulary you can use in real life on the same day.',
          'Close mentorship: human guidance from an educator who understands individual goals and ages.'
        ]}
      />

      <!-- 4 PILLARS -->
      <PillarsSection
        id="pillars"
        eyebrow="Exclusive Methodology"
        title="The 4 Pillars of Personalized Learning"
        description="Discover the pedagogical framework ensuring every minute of your class has direct relevance to your life."
        pillars={pillars}
      />

      <!-- SOLUTIONS -->
      <SolutionsSection
        id="solutions"
        isBand={true}
        eyebrow="Our Solutions"
        title="The right format for your goals and availability"
        description="From 1:1 private coaching for adults and children to immersive group tracks and enterprise training."
        solutions={solutions}
      />

      <!-- TEACHER -->
      <TeacherSection
        id="about"
        eyebrow="Founder & Educator"
        title="Meet Natalia Fernandes"
        description="With over 15 years dedicated to teaching English, Natalia built a methodology centered on real human connection — helping everyone from corporate executives and adults with speaking anxiety to young learners (aged 7+) and expat families find joy and confidence communicating with the world."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, founder of NF English"
        creds={[
          { value: '15+ Years', label: 'of classroom, 1:1 mentoring, and cohort coaching' },
          { value: 'Personalization', label: 'supportive teaching for adults, teens, and kids (7+)' },
          { value: 'Global & In-Company', label: 'students in Brazil, Dubai, and multinational teams' }
        ]}
        manifesto="&ldquo;Fluency does not mean speaking without mistakes or having a native accent. Fluency is having the confidence to express your ideas, lead discussions, and participate in the world without fear.&rdquo;"
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        isBand={true}
        eyebrow="Got Questions?"
        title="Frequently Asked Questions"
        description="Clear answers about our methodology, program formats, and how to get started."
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="Ready to unlock your English with a custom plan?"
        description="Chat directly with our team on WhatsApp to ask questions, book a diagnostic session, or discover the perfect program for you."
        ctaText="Chat on WhatsApp"
        ctaHref={whatsappDiagnostic}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsappDiagnostic} text="Chat on WhatsApp" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Premium personalized English education for adults, kids (7+), expat families, and global corporations. Transforming knowledge into confident communication."
      solutionsTitle="Solutions"
      solutions={[
        { label: '1:1 Executive Mentoring', href: whatsappMentoring, isExternal: true },
        { label: 'Kids & Teens Lessons (7+)', href: whatsappKids, isExternal: true },
        { label: 'Unlock Your English Program', href: '/en/destrave' },
        { label: 'In-Company Corporate Training', href: whatsappCorporate, isExternal: true },
        { label: 'Methodology & Pillars', href: '#personalization' }
      ]}
      contactTitle="Contact & Social"
      contactLinks={[
        { label: 'WhatsApp: +55 (11) 96716-5564', href: 'https://wa.me/5511967165564', isExternal: true },
        { label: 'Back to top', href: '#top' }
      ]}
      copyright={`© ${new Date().getFullYear()} Natalia Fernandes English. All rights reserved.`}
    />
  </div>
</Layout>
