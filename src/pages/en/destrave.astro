---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import CardGridSection from '../../components/CardGridSection.astro';
import ProgramMethodSection from '../../components/ProgramMethodSection.astro';
import TeacherSection from '../../components/TeacherSection.astro';
import CurriculumSection from '../../components/CurriculumSection.astro';
import OfferSection from '../../components/OfferSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';

const whatsapp = 'https://wa.me/5511967165564?text=Hi%20Natalia,%20I%20would%20like%20to%20join%20the%20Unlock%20Your%20English%20waiting%20list.';

const included = [
  '8 weeks of online live coaching and guidance.',
  'Live interactive sessions and short bite-sized videos for vocabulary and listening.',
  'Personalized missions tailored directly to your career and personal interests.',
  'Affinity Map to use your real life as classroom material.',
  'Personal Phrase Bank with high-frequency expressions for real conversations.',
  '10 to 15-minute final conversation milestone, with progress review and next steps.'
];

const weeks = [
  { number: '1', title: "I'm back", description: 'A fresh start without shame and essential survival phrases.' },
  { number: '2', title: 'Things I like', description: 'Interests, hobbies, music, series, food, and sports.' },
  { number: '3', title: 'My routine', description: 'Real routine, work projects, home life, and free time.' },
  { number: '4', title: 'Small talk', description: 'Starting and maintaining natural small talk without panic.' },
  { number: '5', title: 'My stories', description: 'Sharing past anecdotes and experiences smoothly.' },
  { number: '6', title: 'Opinions', description: 'Giving opinions, agreeing, disagreeing, and explaining reasons.' },
  { number: '7', title: 'Real situations', description: 'Listening practice and simulations for travel, work, and socializing.' },
  { number: '8', title: 'Final conversation', description: '10–15 minute live conversation milestone, feedback, and roadmap.' }
];

const faqs = [
  {
    q: 'I feel self-conscious and shy when speaking. Is this course for me?',
    a: 'Yes. The entire foundation of this program is to provide a psychologically safe environment where you speak gradually, make mistakes without embarrassment, and gain authentic confidence.'
  },
  {
    q: 'I studied English before and got nowhere. What makes this different?',
    a: 'The focus is not on memorizing abstract grammar rules. You use real-life topics from your actual routine to actively practice speaking, listening, and spontaneous response.'
  },
  {
    q: 'My English is very basic. Can I join?',
    a: 'The program is designed for adults who have had previous exposure to English. You do not need to speak well, but having basic recognition of the language is helpful.'
  },
  {
    q: 'I have very little free time. Will I be able to keep up?',
    a: 'Yes. The structure combines concise bite-sized recorded lessons, one weekly live cohort session, and small daily micro-missions that naturally fit into a busy schedule.'
  },
  {
    q: 'Will I be forced to speak in front of others?',
    a: 'You will speak, but in a gradual, guided, and supportive manner. The small group setting exists to practice collectively, never to judge or put anyone on the spot.'
  },
  {
    q: 'Does this course promise overnight fluency?',
    a: 'No. The promise is to build authentic speaking confidence, eliminate hesitation, and provide practical conversational fluency for everyday and professional situations.'
  },
  {
    q: 'What if I realize the program is not for me?',
    a: 'You are protected by our 7-day no-questions-asked money-back guarantee. If the program does not meet your expectations, simply request a refund.'
  },
  {
    q: 'How do I enroll in the upcoming cohort?',
    a: 'Click any button to message our team on WhatsApp. We will confirm seat availability, answer questions, and guide you through the next steps.'
  }
];
---

<Layout 
  title="Unlock Your English | Natalia Fernandes English" 
  description="8-week online program for adults who have studied English before but freeze when speaking. Gain real conversational confidence."
  lang="en"
>
  <div class="page" id="top">
    <Header mode="destrave" lang="en" />
    
    <main>
      <!-- HERO -->
      <Hero
        variant="destrave"
        announcement={{
          tag: 'Group Modality',
          strong: 'Unlock Your English is a dedicated group program:',
          text: 'weekly live interactive sessions in small cohorts designed to unlock speaking confidence together.',
          linkText: 'Explore the cohort',
          linkHref: '#program'
        }}
        highlightTag="Small Cohort Group Program • 8 Weeks"
        title="Gain confidence to speak English without freezing."
        description="An 8-week practical group program with live interactive sessions in small cohorts. Practice real conversations in a safe, psychologically supportive space using your real routine and interests."
        primaryAction={{ text: 'Unlock My English in Group', href: whatsapp, isGold: true, isExternal: true }}
        secondaryAction={{ text: 'View Cohort & Investment', href: '#offer', isSecondary: true }}
        microcopy="Join the waiting list to receive early access information without commitment."
        pills={['👥 Small Cohort Groups', '8-Week Live Journey', 'Interactive Practice', '7-Day Guarantee']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, English Teacher and Coach"
        floatingNoteTitle="Psychologically Safe Space:"
        floatingNoteText="Practice with peers in small cohorts where making mistakes is just part of getting better."
      />

      <!-- PROOF BAR -->
      <ProofBar
        ariaLabel="Program overview"
        items={[
          { value: '15+ Years', label: 'of teaching experience with adults' },
          { value: '8', label: 'live interactive online sessions' },
          { value: '24', label: 'bite-sized recorded lessons' },
          { value: '10–15 min', label: 'final conversation to measure your growth' }
        ]}
      />

      <!-- PAIN POINTS -->
      <CardGridSection
        isBand={true}
        title="If you have studied before and still freeze, capability is not the issue."
        description="Most adults hoard grammar rules, word lists, and apps, but lack a psychologically safe space to speak, make mistakes, adjust, and try again."
        columns={4}
        items={[
          { icon: '?', title: 'Mind goes blank', desc: 'You understand parts of the conversation, but words get stuck the moment someone speaks to you.' },
          { icon: '!', title: 'Fear of mistakes', desc: 'Obsessing over perfect grammar and pronunciation freezes you before uttering the first sentence.' },
          { icon: '+', title: 'Tried it all before', desc: 'You spent months or years studying, but felt zero real progress in conversational fluency.' },
          { icon: '✓', title: 'Limited free time', desc: 'You need an achievable, lightweight path that fits into your busy calendar without overwhelm.' }
        ]}
      />

      <!-- PROGRAM METHOD -->
      <ProgramMethodSection
        id="program"
        eyebrow="The Program"
        panelTitle="Unlock Your English"
        panelDescription="A practical framework to build confidence in real conversations — without miracle fluency promises or forcing you to start over."
        panelCtaText="Get Details on WhatsApp"
        panelCtaHref={whatsapp}
        pillars={[
          { icon: '1', title: 'Your life becomes content', desc: 'Work routines, travel plans, favorite music, series, and life stories form our practice.' },
          { icon: '2', title: 'Safe speaking practice', desc: 'Speak gradually with gentle correction, free from anxiety-inducing interruptions.' },
          { icon: '3', title: 'Achievable daily progress', desc: 'Short preparatory videos and simple daily missions keep the language active in your life.' }
        ]}
        includedItems={included}
      />

      <!-- TEACHER -->
      <TeacherSection
        id="natalia"
        isBand={true}
        eyebrow="The Instructor"
        title="Meet Natalia Fernandes, English educator for 15+ years."
        description="Natalia specializes in working with adult professionals who need to convert passive knowledge into spoken fluency. Her approach is close, welcoming, and practical, using real-world contexts to reduce fear and build lasting confidence."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, English Teacher and Coach"
        creds={[
          { value: '15+', label: 'years teaching English' },
          { value: 'Adultos', label: 'specialist with students who tried other methods' },
          { value: 'In-Company', label: 'classes for global brands like Yamaha, Pfizer, Eaton, Mahle & Modine' }
        ]}
      />

      <!-- CURRICULUM -->
      <CurriculumSection
        title="An 8-week journey to speak more and hesitate less."
        description="The goal is to break through speaking paralysis and build a robust conversational repertoire around your routine, hobbies, work, and personal stories."
        steps={weeks}
      />

      <!-- OFFER -->
      <OfferSection
        id="offer"
        isBand={true}
        title="Join the priority waiting list."
        description="The upcoming cohort will be announced first to registered candidates. Join the waiting list to secure early access and determine if this program fits your goals."
        checklist={[
          '8-week immersive online coaching.',
          'Live group sessions and bite-sized recorded lessons.',
          'Personalized practice tied directly to your routine.',
          'Small cohorts for maximum speaking safety.',
          '7-day no-questions-asked money-back guarantee.'
        ]}
        priceAriaLabel="Founding cohort investment"
        priceLabel="Founding Cohort"
        price="R$ 497"
        priceDetails="<strong>Special introductory condition.</strong>"
        priceFull="Standard price for future cohorts: R$ 997."
        offerNote="Founding cohort pricing is reserved exclusively for candidates on the waiting list."
        ctaText="Join the Waiting List"
        ctaHref={whatsapp}
        ctaMicrocopy="No obligations. Speak with our team on WhatsApp before making any decision."
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        title="Frequently Asked Questions"
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="You already know English. It is time to start speaking it."
        description="Join the waiting list for Unlock Your English and receive priority enrollment details for the upcoming cohort."
        ctaText="Join Waiting List"
        ctaHref={whatsapp}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsapp} text="Join the Waiting List" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Online English program for adults who want to communicate with confidence and ease."
      solutionsTitle="Navigation"
      solutions={[
        { label: '← Visit main institutional website', href: '/en' }
      ]}
      contactTitle="Contact"
      contactLinks={[
        { label: 'Team WhatsApp', href: whatsapp, isExternal: true },
        { label: 'Back to top', href: '#top' }
      ]}
      copyright={`© ${new Date().getFullYear()} Natalia Fernandes English. All rights reserved.`}
    />
  </div>
</Layout>
