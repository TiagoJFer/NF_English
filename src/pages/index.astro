---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
import Hero from '../components/Hero.astro';
import ProofBar from '../components/ProofBar.astro';
import CorporateStrip from '../components/CorporateStrip.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import PillarsSection from '../components/PillarsSection.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import TeacherSection from '../components/TeacherSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABanner from '../components/CTABanner.astro';

const whatsappDiagnostic = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20gostaria%20de%20conversar%20sobre%20um%20plano%20personalizado%20de%20ingles.';
const whatsappMentoring = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20tenho%20interesse%20nas%20Aulas%20Individuais%20e%20Mentoria%201:1.';
const whatsappCorporate = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20gostaria%20de%20informacoes%20sobre%20treinamentos%20de%20ingles%20in%20company%20para%20minha%20empresa.';

const pillars = [
  {
    num: '01',
    title: 'Diagnóstico Individual Profundo',
    desc: 'Antes de qualquer aula, analisamos seu histórico com o idioma, suas maiores travas emocionais e seus objetivos imediatos para desenhar a rota ideal.'
  },
  {
    num: '02',
    title: 'Mapa de Afinidades & Vida Real',
    desc: 'Sua rotina profissional, termos da sua área, reuniões, viagens e interesses pessoais viram o material das práticas — zero aulas com assuntos abstratos.'
  },
  {
    num: '03',
    title: 'Segurança Psicológica & Acolhimento',
    desc: 'Criamos um ambiente onde o erro é tratado como ferramenta natural de ajuste. Você fala aos poucos, sem medo de julgamentos ou interrupções constrangedoras.'
  },
  {
    num: '04',
    title: 'Ritmo Adaptado para Adultos Ocupados',
    desc: 'Metodologia flexível com carga horária inteligente e missões aplicáveis no dia a dia, pensada para quem tem rotina intensa e pouco tempo livre.'
  }
];

const solutions = [
  {
    tag: 'Individual & Executivo',
    title: 'Mentoria 1:1 Sob Medida',
    desc: 'Acompanhamento individual focado 100% nas suas metas de carreira, viagens, reuniões internacionais ou apresentações de alto impacto.',
    features: [
      'Plano pedagógico individualizado',
      'Treinamento para situações reais de trabalho',
      'Flexibilidade de ritmo e agenda',
      'Feedback contínuo de pronúncia e fluidez'
    ],
    ctaText: 'Consultar Mentoria 1:1',
    ctaHref: whatsappMentoring,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'Turmas Selecionadas',
    isFeatured: true,
    featuredTag: 'Programa em Grupo',
    title: 'Destrave seu Inglês',
    desc: 'Programa prático de 8 semanas para quem já estudou antes, mas trava quando precisa conversar. Prática acolhedora e repertório real.',
    features: [
      '8 encontros online ao vivo',
      '24 aulas curtas gravadas',
      'Mapa de Afinidades & Phrase Bank pessoal',
      'Conversa final com avaliação de progresso'
    ],
    ctaText: 'Ver Detalhes do Programa ↗',
    ctaHref: '/destrave'
  },
  {
    tag: 'Para Empresas & Equipes',
    title: 'Treinamentos In Company',
    desc: 'Soluções corporativas customizadas para times e líderes que precisam de comunicação ágil e segura em contextos globais de negócios.',
    features: [
      'Diagnóstico de proficiência corporativa',
      'Conteúdo alinhado aos jargões e processos da empresa',
      'Histórico com marcas como Yamaha, Eaton e Mahle',
      'Relatórios periódicos de engajamento e evolução'
    ],
    ctaText: 'Soluções Corporativas',
    ctaHref: whatsappCorporate,
    ctaClass: 'secondary',
    isExternal: true
  }
];

const faqs = [
  {
    q: 'Como funciona a personalização do ensino na prática?',
    a: 'Após uma avaliação inicial de perfil e objetivos, construímos o planejamento com temas, vocabulário e situações diretamente ligadas ao seu cotidiano — sejam reuniões de trabalho, entrevistas internacionais, viagens ou conversas casuais. Nada de seguir livros genéricos página por página.'
  },
  {
    q: 'Para quem são indicadas as aulas e mentorias da NF English?',
    a: 'Nosso foco é exclusivamente o público adulto e profissional: pessoas que já tiveram contato prévio com o idioma ou estudaram anos, mas ainda travam na hora de falar e precisam de segurança para se comunicar no trabalho e na vida pessoal.'
  },
  {
    q: 'Qual a diferença entre a Mentoria 1:1 e o Programa Destrave seu Inglês?',
    a: 'A Mentoria 1:1 é um acompanhamento individual exclusivo, com agenda flexível e foco 100% sob medida para metas urgentes e específicas. O Destrave seu Inglês é um programa imersivo em grupo de 8 semanas com turmas reduzidas, ideal para destravar a conversação em um ambiente coletivo seguro.'
  },
  {
    q: 'Como funcionam os treinamentos corporativos (In Company)?',
    a: 'Desenvolvemos programas customizados para equipes e executivos, integrando as demandas da empresa, jargões do setor e situações práticas de negócios (apresentações, negociações e e-mails). Já atendemos marcas de referência como Yamaha, Eaton e Mahle.'
  },
  {
    q: 'As aulas são online ou presenciais?',
    a: 'Todas as soluções são realizadas 100% online ao vivo, com ferramentas interativas e suporte próximo, permitindo que você participe de qualquer lugar com total conveniência.'
  },
  {
    q: 'Como posso dar o primeiro passo?',
    a: 'Basta clicar em qualquer um dos botões desta página para conversar diretamente com a Natalia ou nossa equipe no WhatsApp. Faremos um diagnóstico rápido do seu momento para recomendar o melhor formato para você.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Ensino Personalizado de Inglês para Adultos e Empresas" 
  description="Ensino de inglês de excelência com foco em hiper-personalização, segurança para falar e autoridade de 15 anos. Aulas 1:1, programas em grupo e in-company."
>
  <div class="page" id="top">
    <Header mode="institutional" />
    
    <main>
      <!-- HERO -->
      <Hero
        title="O inglês que se adapta à sua vida, à sua carreira e ao seu ritmo."
        description="Sem fórmulas prontas ou turmas genéricas. Há 15 anos transformamos conhecimento passivo em segurança para falar, através de uma metodologia sob medida para adultos e profissionais."
        primaryAction={{ text: 'Conversar sobre seu plano', href: whatsappDiagnostic, isExternal: true }}
        secondaryAction={{ text: 'Conhecer formatos de aula', href: '#solucoes' }}
        microcopy="Atendimento consultivo e acolhedor via WhatsApp. Sem compromisso."
        pills={['15 anos de história', '100% focado em adultos', 'Experiência corporativa', 'Acompanhamento individual e em grupo']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, fundadora da NF English"
        floatingNoteTitle="Personalização de verdade:"
        floatingNoteText="O material das aulas é a sua profissão, seus interesses e os desafios reais do seu dia a dia."
      />

      <!-- MÉTRICAS -->
      <ProofBar
        ariaLabel="Credenciais e diferenciais NF English"
        items={[
          { value: '15+ anos', label: 'de dedicação exclusiva ao ensino de adultos' },
          { value: '100% Personalizado', label: 'estratégia desenhada para sua rotina e objetivos' },
          { value: 'In Company', label: 'treinamentos para grandes indústrias e empresas' },
          { value: 'Foco em Fala', label: 'segurança e autonomia para conversas reais' }
        ]}
      />

      <!-- MARCAS / CORPORATIVO -->
      <div id="empresas">
        <CorporateStrip
          label="Confiança comprovada por profissionais e grandes corporações:"
          extraBadge="+ Executivos & Profissionais"
        />
      </div>

      <!-- COMPARATIVO -->
      <ComparisonSection
        isBand={true}
        eyebrow="O Problema do Método Tradicional"
        title="Por que cursos genéricos não funcionam para adultos ocupados?"
        description="A maioria dos cursos tradicionais coloca todos os alunos na mesma esteira mecânica. O resultado é frustração, perda de tempo e a sensação de que você 'não leva jeito' para o inglês."
        traditionalTitle="Ensino Tradicional de Prateleira"
        traditionalDesc="O modelo engessado que ignora a realidade do aluno adulto:"
        traditionalItems={[
          'Apostilas padronizadas com diálogos artificiais e temas desconectados da sua rotina.',
          'Turmas volumosas com níveis e objetivos misturados, gerando vergonha e pouca fala.',
          'Foco excessivo em regras gramaticais e decoreba teórica sem aplicação imediata.',
          'Correções ríspidas que inibem a espontaneidade e geram bloqueio na hora de falar.'
        ]}
        nfTitle="Aprender com Personalização Real"
        nfDesc="O método que se molda a quem você é e ao que você precisa:"
        nfBadge="O Diferencial NF English"
        nfItems={[
          'Conteúdo vivo: sua carreira, projetos, viagens e histórias pessoais viram material de aula.',
          'Segurança psicológica: ambiente acolhedor onde errar é parte natural do ajuste fino da fala.',
          'Relevância imediata: você aprende vocabulário e expressões que usa no mesmo dia no trabalho.',
          'Acompanhamento próximo: orientação humana de quem entende a rotina de profissionais ocupados.'
        ]}
      />

      <!-- 4 PILARES -->
      <PillarsSection
        id="personalizacao"
        eyebrow="Metodologia Exclusiva"
        title="Os 4 Pilares da Aprendizagem Personalizada"
        description="Conheça a estrutura pedagógica que garante que cada minuto de aula tenha relevância direta para você."
        pillars={pillars}
      />

      <!-- SOLUÇÕES -->
      <SolutionsSection
        id="solucoes"
        isBand={true}
        eyebrow="Nossas Soluções"
        title="O formato certo para o seu objetivo e disponibilidade"
        description="De mentorias individuais a imersões em grupo e treinamentos para empresas, temos uma solução desenhada para você."
        solutions={solutions}
      />

      <!-- AUTORIDADE -->
      <TeacherSection
        id="sobre"
        eyebrow="Fundadora & Professora"
        title="Conheça Natalia Fernandes"
        description="Com mais de 15 anos dedicados ao ensino de inglês, a Natalia construiu uma trajetória focada no desenvolvimento de alunos adultos — ajudando desde profissionais com traumas em cursos tradicionais até executivos de multinacionais a conquistarem autonomia de fala."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Professora Natalia Fernandes, fundadora da NF English"
        creds={[
          { value: '15+ Anos', label: 'de experiência em sala e mentoria individual' },
          { value: 'Adultos', label: 'especialista em desbloqueio e comunicação real' },
          { value: 'In Company', label: 'treinamentos para grandes indústrias e corporações' }
        ]}
        manifesto="&ldquo;Fluência não significa falar perfeitamente ou ter sotaque nativo. Fluência é a liberdade de se expressar com clareza, defender suas ideias e participar do mundo sem medo.&rdquo;"
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        isBand={true}
        eyebrow="Tira-Dúvidas"
        title="Perguntas Frequentes"
        description="Respostas claras sobre metodologia, formatos de atendimento e como começar."
        faqs={faqs}
      />

      <!-- CTA FINAL -->
      <CTABanner
        title="Pronto para destravar seu inglês com um plano feito sob medida?"
        description="Fale diretamente com nossa equipe no WhatsApp para tirar dúvidas, agendar um diagnóstico pedagógico ou entender qual solução é perfeita para você."
        ctaText="Conversar no WhatsApp"
        ctaHref={whatsappDiagnostic}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsappDiagnostic} text="Falar no WhatsApp" />

    <!-- FOOTER -->
    <Footer />
  </div>
</Layout>
