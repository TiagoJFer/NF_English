---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const whatsappDiagnostic = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20gostaria%20de%20conversar%20sobre%20um%20plano%20personalizado%20de%20ingles.';
const whatsappMentoring = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20tenho%20interesse%20nas%20Aulas%20Individuais%20e%20Mentoria%201:1.';
const whatsappCorporate = 'https://wa.me/5511967165564?text=Ola%20Natalia,%20gostaria%20de%20informacoes%20sobre%20treinamentos%20de%20ingles%20in%20company%20para%20minha%20empresa.';

const pillars = [
  {
    num: '01',
    title: 'Diagnóstico Individual Profundo',
    desc: 'Antes de qualquer aula, analisamos seu histórico com o idioma, suas maiores travas emocionais e seus objetivos imediatos para desenhar a rota ideal.'
  },
  {
    num: '02',
    title: 'Mapa de Afinidades & Vida Real',
    desc: 'Sua rotina profissional, termos da sua área, reuniões, viagens e interesses pessoais viram o material das práticas — zero aulas com assuntos abstratos.'
  },
  {
    num: '03',
    title: 'Segurança Psicológica & Acolhimento',
    desc: 'Criamos um ambiente onde o erro é tratado como ferramenta natural de ajuste. Você fala aos poucos, sem medo de julgamentos ou interrupções constrangedoras.'
  },
  {
    num: '04',
    title: 'Ritmo Adaptado para Adultos Ocupados',
    desc: 'Metodologia flexível com carga horária inteligente e missões aplicáveis no dia a dia, pensada para quem tem rotina intensa e pouco tempo livre.'
  }
];

const faqs = [
  {
    q: 'Como funciona a personalização do ensino na prática?',
    a: 'Após uma avaliação inicial de perfil e objetivos, construímos o planejamento com temas, vocabulário e situações diretamente ligadas ao seu cotidiano — sejam reuniões de trabalho, entrevistas internacionais, viagens ou conversas casuais. Nada de seguir livros genéricos página por página.'
  },
  {
    q: 'Para quem são indicadas as aulas e mentorias da NF English?',
    a: 'Nosso foco é exclusivamente o público adulto e profissional: pessoas que já tiveram contato prévio com o idioma ou estudaram anos, mas ainda travam na hora de falar e precisam de segurança para se comunicar no trabalho e na vida pessoal.'
  },
  {
    q: 'Qual a diferença entre a Mentoria 1:1 e o Programa Destrave seu Inglês?',
    a: 'A Mentoria 1:1 é um acompanhamento individual exclusivo, com agenda flexível e foco 100% sob medida para metas urgentes e específicas. O Destrave seu Inglês é um programa imersivo em grupo de 8 semanas com turmas reduzidas, ideal para destravar a conversação em um ambiente coletivo seguro.'
  },
  {
    q: 'Como funcionam os treinamentos corporativos (In Company)?',
    a: 'Desenvolvemos programas customizados para equipes e executivos, integrando as demandas da empresa, jargões do setor e situações práticas de negócios (apresentações, negociações e e-mails). Já atendemos marcas de referência como Yamaha, Eaton e Mahle.'
  },
  {
    q: 'As aulas são online ou presenciais?',
    a: 'Todas as soluções são realizadas 100% online ao vivo, com ferramentas interativas e suporte próximo, permitindo que você participe de qualquer lugar com total conveniência.'
  },
  {
    q: 'Como posso dar o primeiro passo?',
    a: 'Basta clicar em qualquer um dos botões desta página para conversar diretamente com a Natalia ou nossa equipe no WhatsApp. Faremos um diagnóstico rápido do seu momento para recomendar o melhor formato para você.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Ensino Personalizado de Inglês para Adultos e Empresas" 
  description="Ensino de inglês de excelência com foco em hiper-personalização, segurança para falar e autoridade de 15 anos. Aulas 1:1, programas em grupo e in-company."
>
  <div class="page" id="top">
    <Header mode="institutional" />
    
    <main>
      <!-- HERO INSTITUCIONAL -->
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow"><span class="dot"></span> Excelência & Personalização</div>
            <h1>O inglês que se adapta à sua vida, à sua carreira e ao seu ritmo.</h1>
            <p class="hero-copy">
              Sem fórmulas prontas ou turmas genéricas. Há 15 anos transformamos conhecimento passivo em segurança para falar, através de uma metodologia sob medida para adultos e profissionais.
            </p>
            <div class="hero-actions">
              <a class="button" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
                Conversar sobre seu plano
              </a>
              <a class="button secondary" href="#solucoes">
                Conhecer formatos de aula
              </a>
            </div>
            <p class="microcopy">Atendimento consultivo e acolhedor via WhatsApp. Sem compromisso.</p>
            <div class="hero-proof">
              <span class="pill">15 anos de história</span>
              <span class="pill">100% focado em adultos</span>
              <span class="pill">Experiência corporativa</span>
              <span class="pill">Acompanhamento individual e em grupo</span>
            </div>
          </div>

          <div class="hero-image-wrapper">
            <div class="hero-circle-frame">
              <picture>
                <source srcset="/Nath.webp" type="image/webp" />
                <img src="/Nath.jpg" alt="Natalia Fernandes, fundadora da NF English" width="576" height="1024" fetchpriority="high" loading="eager" decoding="async" />
              </picture>
            </div>
            <div class="floating-note">
              <strong>Personalização de verdade:</strong>
              <p>O material das aulas é a sua profissão, seus interesses e os desafios reais do seu dia a dia.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- BARRA DE MÉTRICAS / AUTORIDADE -->
      <div class="proof">
        <div class="container proof-row" aria-label="Credenciais e diferenciais NF English">
          <div class="proof-item">
            <b>15+ anos</b>
            <span>de dedicação exclusiva ao ensino de adultos</span>
          </div>
          <div class="proof-item">
            <b>100% Personalizado</b>
            <span>estratégia desenhada para sua rotina e objetivos</span>
          </div>
          <div class="proof-item">
            <b>In Company</b>
            <span>treinamentos para grandes indústrias e empresas</span>
          </div>
          <div class="proof-item">
            <b>Foco em Fala</b>
            <span>segurança e autonomia para conversas reais</span>
          </div>
        </div>
      </div>

      <!-- FAIXA CORPORATIVA / MARCAS ATENDIDAS -->
      <div class="corporate-strip" id="empresas">
        <div class="container corporate-inner">
          <span class="corporate-label">Confiança comprovada por profissionais e grandes corporações:</span>
          <div class="corporate-logos">
            <span class="corp-badge">YAMAHA</span>
            <span class="corp-badge">EATON</span>
            <span class="corp-badge">MAHLE</span>
            <span class="corp-badge">+ Executivos & Profissionais</span>
          </div>
        </div>
      </div>

      <!-- O PROBLEMA DO ENSINO TRADICIONAL VS PERSONALIZAÇÃO -->
      <section class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> O Problema do Método Tradicional</div>
            <h2>Por que cursos genéricos não funcionam para adultos ocupados?</h2>
            <p>
              A maioria dos cursos tradicionais coloca todos os alunos na mesma esteira mecânica. O resultado é frustração, perda de tempo e a sensação de que você "não leva jeito" para o inglês.
            </p>
          </div>

          <div class="compare-grid">
            <div class="compare-box traditional">
              <h3>Ensino Tradicional de Prateleira</h3>
              <p class="muted">O modelo engessado que ignora a realidade do aluno adulto:</p>
              <ul class="compare-list traditional">
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Apostilas padronizadas com diálogos artificiais e temas desconectados da sua rotina.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Turmas volumosas com níveis e objetivos misturados, gerando vergonha e pouca fala.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Foco excessivo em regras gramaticais e decoreba teórica sem aplicação imediata.</span>
                </li>
                <li>
                  <span class="compare-icon bad">✕</span>
                  <span>Correções ríspidas que inibem a espontaneidade e geram bloqueio na hora de falar.</span>
                </li>
              </ul>
            </div>

            <div class="compare-box nf">
              <span class="compare-badge">O Diferencial NF English</span>
              <h3>Aprender com Personalização Real</h3>
              <p class="muted">O método que se molda a quem você é e ao que você precisa:</p>
              <ul class="compare-list">
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Conteúdo vivo:</strong> sua carreira, projetos, viagens e histórias pessoais viram material de aula.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Segurança psicológica:</strong> ambiente acolhedor onde errar é parte natural do ajuste fino da fala.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Relevância imediata:</strong> você aprende vocabulário e expressões que usa no mesmo dia no trabalho.</span>
                </li>
                <li>
                  <span class="compare-icon good">✓</span>
                  <span><strong>Acompanhamento próximo:</strong> orientação humana de quem entende a rotina de profissionais ocupados.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- OS 4 PILARES DA PERSONALIZAÇÃO -->
      <section id="personalizacao">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow sage"><span class="dot"></span> Metodologia Exclusiva</div>
            <h2>Os 4 Pilares da Aprendizagem Personalizada</h2>
            <p>Conheça a estrutura pedagógica que garante que cada minuto de aula tenha relevância direta para você.</p>
          </div>

          <div class="pillars-4">
            {pillars.map((pillar) => (
              <div class="pillar-card">
                <div class="pillar-num">{pillar.num}</div>
                <div class="pillar-content">
                  <h3>{pillar.title}</h3>
                  <p>{pillar.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SOLUÇÕES E FORMATOS -->
      <section id="solucoes" class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> Nossas Soluções</div>
            <h2>O formato certo para o seu objetivo e disponibilidade</h2>
            <p>De mentorias individuais a imersões em grupo e treinamentos para empresas, temos uma solução desenhada para você.</p>
          </div>

          <div class="solutions-grid">
            <!-- 1:1 Mentoria -->
            <div class="solution-card">
              <div>
                <div class="solution-tag">Individual & Executivo</div>
                <h3>Mentoria 1:1 Sob Medida</h3>
                <p class="solution-desc">
                  Acompanhamento individual focado 100% nas suas metas de carreira, viagens, reuniões internacionais ou apresentações de alto impacto.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> Plano pedagógico individualizado</li>
                  <li><span class="chk">✓</span> Treinamento para situações reais de trabalho</li>
                  <li><span class="chk">✓</span> Flexibilidade de ritmo e agenda</li>
                  <li><span class="chk">✓</span> Feedback contínuo de pronúncia e fluidez</li>
                </ul>
              </div>
              <a class="button secondary" href={whatsappMentoring} target="_blank" rel="noreferrer">
                Consultar Mentoria 1:1
              </a>
            </div>

            <!-- Destrave em Grupo (Destaque) -->
            <div class="solution-card featured">
              <span class="solution-featured-tag">Programa em Grupo</span>
              <div>
                <div class="solution-tag">Turmas Selecionadas</div>
                <h3>Destrave seu Inglês</h3>
                <p class="solution-desc">
                  Programa prático de 8 semanas para quem já estudou antes, mas trava quando precisa conversar. Prática acolhedora e repertório real.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> 8 encontros online ao vivo</li>
                  <li><span class="chk">✓</span> 24 aulas curtas gravadas</li>
                  <li><span class="chk">✓</span> Mapa de Afinidades & Phrase Bank pessoal</li>
                  <li><span class="chk">✓</span> Conversa final com avaliação de progresso</li>
                </ul>
              </div>
              <a class="button" href="/destrave">
                Ver Detalhes do Programa ↗
              </a>
            </div>

            <!-- Corporativo -->
            <div class="solution-card">
              <div>
                <div class="solution-tag">Para Empresas & Equipes</div>
                <h3>Treinamentos In Company</h3>
                <p class="solution-desc">
                  Soluções corporativas customizadas para times e líderes que precisam de comunicação ágil e segura em contextos globais de negócios.
                </p>
                <ul class="solution-features">
                  <li><span class="chk">✓</span> Diagnóstico de proficiência corporativa</li>
                  <li><span class="chk">✓</span> Conteúdo alinhado aos jargões e processos da empresa</li>
                  <li><span class="chk">✓</span> Histórico com marcas como Yamaha, Eaton e Mahle</li>
                  <li><span class="chk">✓</span> Relatórios periódicos de engajamento e evolução</li>
                </ul>
              </div>
              <a class="button secondary" href={whatsappCorporate} target="_blank" rel="noreferrer">
                Soluções Corporativas
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- SOBRE A NATALIA FERNANDES -->
      <section id="sobre">
        <div class="container teacher">
          <div class="teacher-photo">
            <picture>
              <source srcset="/Nath.webp" type="image/webp" />
              <img src="/Nath.jpg" alt="Professora Natalia Fernandes, fundadora da NF English" width="576" height="1024" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div>
            <div class="section-head">
              <div class="eyebrow"><span class="dot"></span> Fundadora & Professora</div>
              <h2>Conheça Natalia Fernandes</h2>
              <p>
                Com mais de 15 anos dedicados ao ensino de inglês, a Natalia construiu uma trajetória focada no desenvolvimento de alunos adultos — ajudando desde profissionais com traumas em cursos tradicionais até executivos de multinacionais a conquistarem autonomia de fala.
              </p>
            </div>

            <div class="grid cred-grid">
              <div class="cred">
                <b>15+ Anos</b>
                <span>de experiência em sala e mentoria individual</span>
              </div>
              <div class="cred">
                <b>Adultos</b>
                <span>especialista em desbloqueio e comunicação real</span>
              </div>
              <div class="cred">
                <b>In Company</b>
                <span>treinamentos para grandes indústrias e corporações</span>
              </div>
            </div>

            <div class="teacher-manifesto">
              "Fluência não significa falar perfeitamente ou ter sotaque nativo. Fluência é a liberdade de se expressar com clareza, defender suas ideias e participar do mundo sem medo."
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ INSTITUCIONAL -->
      <section id="faq" class="band">
        <div class="container">
          <div class="section-head center">
            <div class="eyebrow"><span class="dot"></span> Tira-Dúvidas</div>
            <h2>Perguntas Frequentes</h2>
            <p>Respostas claras sobre metodologia, formatos de atendimento e como começar.</p>
          </div>

          <div class="grid faq-grid">
            {faqs.map((faq) => (
              <details>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="final-cta">
        <div class="container final-grid">
          <div>
            <h2>Pronto para destravar seu inglês com um plano feito sob medida?</h2>
            <p>
              Fale diretamente com nossa equipe no WhatsApp para tirar dúvidas, agendar um diagnóstico pedagógico ou entender qual solução é perfeita para você.
            </p>
          </div>
          <a class="button gold" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
            Conversar no WhatsApp
          </a>
        </div>
      </section>
    </main>

    <!-- MOBILE FLOATING CTA -->
    <div class="mobile-cta">
      <a class="button" href={whatsappDiagnostic} target="_blank" rel="noreferrer">
        Falar no WhatsApp
      </a>
    </div>

    <!-- FOOTER INSTITUCIONAL -->
    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <div class="brand" style="margin-bottom: 14px;">
              <span class="brand-mark">NF</span>
              <span>Natalia Fernandes English</span>
            </div>
            <p class="muted">
              Ensino de inglês personalizado de alta excelência para adultos, líderes e empresas. Transformando conhecimento teórico em comunicação real com segurança e acolhimento.
            </p>
          </div>

          <div class="footer-col">
            <strong>Soluções</strong>
            <ul class="footer-links">
              <li><a href={whatsappMentoring} target="_blank" rel="noreferrer">Mentoria 1:1 Executiva</a></li>
              <li><a href="/destrave">Programa Destrave seu Inglês</a></li>
              <li><a href={whatsappCorporate} target="_blank" rel="noreferrer">Treinamentos In-Company</a></li>
              <li><a href="#personalizacao">Metodologia e Pilares</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <strong>Contato & Redes</strong>
            <ul class="footer-links">
              <li><a href={whatsappDiagnostic} target="_blank" rel="noreferrer">WhatsApp: +55 (11) 96716-5564</a></li>
              <li><a href="#top">Voltar ao topo</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div>© {new Date().getFullYear()} Natalia Fernandes English. Todos os direitos reservados.</div>
          <div>nfenglish.com.br</div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
