---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import CardGridSection from '../../components/CardGridSection.astro';
import ProgramMethodSection from '../../components/ProgramMethodSection.astro';
import TeacherSection from '../../components/TeacherSection.astro';
import CurriculumSection from '../../components/CurriculumSection.astro';
import OfferSection from '../../components/OfferSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';

const msgWaitlist = 'Здравствуйте, Наталья! Я хочу записаться в лист ожидания программы Destrave seu Inglês.';
const whatsapp = `https://wa.me/5511967165564?text=${encodeURIComponent(msgWaitlist)}`;

const included = [
  '8 недель онлайн-сопровождения и практики в живом эфире.',
  'Живые интерактивные сессии и короткие видеоуроки для лексики и восприятия на слух.',
  'Персональные миссии, напрямую связанные с вашей работой и увлечениями.',
  'Карта интересов для использования контекста вашей жизни как основы уроков.',
  'Личный Phrase Bank с ключевыми выражениями для реального общения.',
  'Итоговый диалог 10–15 минут с разбором прогресса и рекомендациями на будущее.'
];

const weeks = [
  { number: '1', title: "I'm back", description: 'Перезагрузка без стеснения и базовые фразы для старта.' },
  { number: '2', title: 'Things I like', description: 'Увлечения, хобби, музыка, сериалы, гастрономия и спорт.' },
  { number: '3', title: 'My routine', description: 'Реальный распорядок дня, рабочие задачи, дом и досуг.' },
  { number: '4', title: 'Small talk', description: 'Умение начинать и легко поддерживать диалог без стресса.' },
  { number: '5', title: 'My stories', description: 'Рассказ о событиях прошлого и личном опыте без запинок.' },
  { number: '6', title: 'Opinions', description: 'Выражение собственного мнения, согласие, несогласие и аргументы.' },
  { number: '7', title: 'Real situations', description: 'Практика на слух и симуляции: путешествия, работа, сервисы.' },
  { number: '8', title: 'Final conversation', description: 'Итоговый живой диалог 10–15 минут, оценка роста и дальнейший план.' }
];

const faqs = [
  {
    q: 'Я стесняюсь говорить. Подойдет ли мне этот курс?',
    a: 'Да. Главная задача программы — создать психологически комфортную среду, где вы говорите без страха ошибок и постепенно обретаете уверенность.'
  },
  {
    q: 'Я уже учил язык раньше, но так и не заговорил. Что изменится?',
    a: 'Фокус программы — не заучивание сухой теории, а живая разговорная практика на темы вашей реальной жизни.'
  },
  {
    q: 'У меня базовый уровень. Смогу ли я учиться?',
    a: 'Программа подходит всем, у кого уже был контакт с языком. Не нужно говорить свободно, достаточно знать базовые основы.'
  },
  {
    q: 'У меня мало свободного времени. Справлюсь ли я?',
    a: 'Формат включает короткие видео, одну еженедельную живую сессию и простые ежедневные миссии, которые легко встроить в рабочий график.'
  },
  {
    q: 'Придется ли мне говорить перед другими?',
    a: 'Да, но в доброжелательной и поддерживающей атмосфере малых групп, созданной специально для взаимной практики без критики.'
  },
  {
    q: 'Обещает ли курс мгновенную идеальную беглость?',
    a: 'Нет. Мы даем реальную уверенность, словарный запас и практику, чтобы вы перестали бояться и заговорили в повседневных и рабочих ситуациях.'
  },
  {
    q: 'Что если я пойму, что программа мне не подходит?',
    a: 'Вы защищены гарантией возврата средств в течение 7 дней с момента старта курса без лишних вопросов.'
  },
  {
    q: 'Как записаться в ближайший поток?',
    a: 'Нажмите на любую кнопку для связи в WhatsApp. Команда подтвердит наличие мест и вышлет подробную информацию.'
  }
];
---

<Layout 
  title="Программа Destrave | Natalia Fernandes English" 
  description="8-недельная онлайн-программа для взрослых, которые учили английский, но испытывают языковой барьер. Обретите настоящую уверенность в речи."
  lang="ru"
>
  <div class="page" id="top">
    <Header mode="destrave" lang="ru" />
    
    <main>
      <!-- HERO -->
      <Hero
        variant="destrave"
        announcement={{
          tag: 'Групповой формат',
          strong: 'Destrave — наша программа обучения в группе:',
          text: 'еженедельные живые онлайн-сессии в мини-группах для преодоления языкового барьера в безопасной атмосфере.',
          linkText: 'О формате группы',
          linkHref: '#program'
        }}
        highlightTag="Групповой интенсив • Мини-группы"
        title="Обретите уверенность говорить по-английски без языкового барьера."
        description="8-недельная практическая онлайн-программа в мини-группах. Тренируйте живую спонтанную речь в безопасной и поддерживающей атмосфере на основе вашей реальной жизни."
        primaryAction={{ text: 'Записаться в группу Destrave', href: whatsapp, isGold: true, isExternal: true }}
        secondaryAction={{ text: 'Условия и стоимость', href: '#offer', isSecondary: true }}
        microcopy="Запишитесь в лист ожидания, чтобы получить информацию о наборе без обязательств."
        pills={['👥 Мини-группы', '8 недель практики', 'Живые онлайн-сессии', 'Гарантия 7 дней']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Наталья Фернандес, преподаватель английского языка"
        floatingNoteTitle="Безопасная среда в группе:"
        floatingNoteText="Практика без страха ошибок и критики — все участники идут к одной цели."
      />

      <!-- PROOF BAR -->
      <ProofBar
        ariaLabel="Обзор программы"
        items={[
          { value: '15+ Лет', label: 'опыта преподавания взрослым' },
          { value: '8', label: 'живых онлайн-сессий в эфире' },
          { value: '24', label: 'коротких видеоурока' },
          { value: '10–15 мин', label: 'итоговый разговор для наглядной оценки прогресса' }
        ]}
      />

      <!-- PAIN POINTS -->
      <CardGridSection
        isBand={true}
        title="Если вы учили язык и все равно боитесь говорить — дело не в способностях."
        description="Большинство людей годами копят правила и слова в приложениях, но у них нет безопасного пространства, чтобы практиковать речь, ошибаться без стеснения и адаптироваться."
        columns={4}
        items={[
          { icon: '?', title: 'Ступор при разговоре', desc: 'Вы понимаете суть, но не можете вымолвить фразу в нужный момент.' },
          { icon: '!', title: 'Страх ошибки', desc: 'Желание говорить идеально блокирует речь до того, как вы скажете первое слово.' },
          { icon: '+', title: 'Уже пробовали раньше', desc: 'Учили английский годами, но так и не почувствовали уверенности в разговоре.' },
          { icon: '✓', title: 'Мало времени', desc: 'Нужен реалистичный и комфортный путь, не требующий часов занятий каждый день.' }
        ]}
      />

      <!-- PROGRAM METHOD -->
      <ProgramMethodSection
        id="program"
        eyebrow="О программе"
        panelTitle="Программа Destrave"
        panelDescription="Практический маршрут к уверенному общению — без нереалистичных обещаний и без необходимости начинать все заново."
        panelCtaText="Подробнее в WhatsApp"
        panelCtaHref={whatsapp}
        pillars={[
          { icon: '1', title: 'Ваша жизнь — тема уроков', desc: 'Работа, путешествия, хобби, сериалы и личный опыт становятся материалом занятий.' },
          { icon: '2', title: 'Безопасная практика', desc: 'Вы говорите с бережной коррекцией и без стрессовых перебиваний.' },
          { icon: '3', title: 'Реалистичный прогресс', desc: 'Короткие подготовительные видео и простые ежедневные миссии поддерживают язык в тонусе.' }
        ]}
        includedItems={included}
      />

      <!-- TEACHER -->
      <TeacherSection
        id="natalia"
        isBand={true}
        eyebrow="Преподаватель"
        title="С Натальей Фернандес, преподавателем английского с опытом 15+ лет."
        description="Наталья работает со взрослыми, которым необходимо превратить пассивные знания в свободную речь. Ее подход — чуткий, доброжелательный и практичный, основанный на реальных ситуациях."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Наталья Фернандес, преподаватель английского языка"
        creds={[
          { value: '15+', label: 'лет преподавания английского' },
          { value: 'Взрослые', label: 'специализация на снятии языковых барьеров' },
          { value: 'In-Company', label: 'уроки для лидеров Yamaha, Pfizer, Eaton, Mahle и Modine' }
        ]}
      />

      <!-- CURRICULUM -->
      <CurriculumSection
        title="8-недельный путь к свободной речи без страха."
        description="Цель — преодолеть ступор и наработать активный словарный запас для обсуждения работы, планов, поездок и личных историй."
        steps={weeks}
      />

      <!-- OFFER -->
      <OfferSection
        id="offer"
        isBand={true}
        title="Запишитесь в лист ожидания."
        description="Информация о старте нового набора будет направлена в первую очередь участникам листа ожидания."
        checklist={[
          '8-недельная программа онлайн-практики.',
          'Живые сессии и короткие видеоматериалы.',
          'Практика, основанная на вашем распорядке и целях.',
          'Малая группа для максимального комфорта.',
          'Гарантия возврата средств 7 дней.'
        ]}
        priceAriaLabel="Стоимость для участников первого набора"
        priceLabel="Первый поток"
        price="R$ 497"
        priceDetails="<strong>Специальные стартовые условия.</strong>"
        priceFull="Полная стоимость следующих потоков: R$ 997."
        offerNote="Условия первого потока доступны только кандидатам из листа ожидания."
        ctaText="Записаться в лист ожидания"
        ctaHref={whatsapp}
        ctaMicrocopy="Без обязательств. Вы сможете задать любые вопросы команде перед решением."
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        title="Часто задаваемые вопросы"
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="Вы уже учили английский. Пришло время заговорить на нем."
        description="Запишитесь в лист ожидания программы Destrave и первыми получите условия участия."
        ctaText="Вступить в лист ожидания"
        ctaHref={whatsapp}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsapp} text="Записаться в лист ожидания" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Онлайн-программа для взрослых, желающих уверенно и свободно общаться на английском языке."
      solutionsTitle="Навигация"
      solutions={[
        { label: '← На главную страницу сайта', href: '/ru' }
      ]}
      contactTitle="Контакты"
      contactLinks={[
        { label: 'WhatsApp команды', href: whatsapp, isExternal: true },
        { label: 'Наверх', href: '#top' }
      ]}
      copyright={`© ${new Date().getFullYear()} Natalia Fernandes English. Все права защищены.`}
    />
  </div>
</Layout>
