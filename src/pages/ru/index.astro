---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import CorporateStrip from '../../components/CorporateStrip.astro';
import ComparisonSection from '../../components/ComparisonSection.astro';
import PillarsSection from '../../components/PillarsSection.astro';
import SolutionsSection from '../../components/SolutionsSection.astro';
import TeacherSection from '../../components/TeacherSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';

const msgDiagnostic = 'Здравствуйте, Наталья! Я хочу обсудить индивидуальный план обучения английскому языку.';
const msgMentoring = 'Здравствуйте, Наталья! Меня интересует индивидуальное наставничество 1:1.';
const msgKids = 'Здравствуйте, Наталья! Я хочу узнать об уроках английского языка для детей (7+) и международных семей.';
const msgCorporate = 'Здравствуйте, Наталья! Я хочу узнать о корпоративном обучении английскому языку для компании.';

const whatsappDiagnostic = `https://wa.me/5511967165564?text=${encodeURIComponent(msgDiagnostic)}`;
const whatsappMentoring = `https://wa.me/5511967165564?text=${encodeURIComponent(msgMentoring)}`;
const whatsappKids = `https://wa.me/5511967165564?text=${encodeURIComponent(msgKids)}`;
const whatsappCorporate = `https://wa.me/5511967165564?text=${encodeURIComponent(msgCorporate)}`;

const pillars = [
  {
    num: '01',
    title: 'Глубокая индивидуальная диагностика',
    desc: 'Перед началом занятий мы детально разбираем предыдущий опыт, психологические барьеры и конкретные цели, чтобы выстроить точный маршрут.'
  },
  {
    num: '02',
    title: 'Карта интересов и реальная жизнь',
    desc: 'Ваша работа, проекты, поездки, хобби или мир интересов ребенка становятся основой уроков — никакой абстрактной теории из шаблонных учебников.'
  },
  {
    num: '03',
    title: 'Психологический комфорт и поддержка',
    desc: 'Мы создаем безопасную среду, где ошибки воспринимаются как естественный этап роста. Вы начинаете говорить уверенно, без страха критики или неловких пауз.'
  },
  {
    num: '04',
    title: 'Индивидуальный темп и методика',
    desc: 'Гибкая методика с продуманной нагрузкой и адаптированной подачей — как для занятых специалистов, так и для детей с игровым и живым обучением.'
  }
];

const solutions = [
  {
    tag: 'Индивидуально & Для лидеров',
    title: 'Менторство 1:1',
    desc: 'Персональная программа на 100% под ваши цели: карьерный рост, международные переговоры, собеседования или зарубежные поездки.',
    features: [
      'Индивидуальный учебный план',
      'Отработка реальных рабочих сценариев',
      'Гибкий график занятий',
      'Регулярный фидбек по произношению и беглости'
    ],
    ctaText: 'Узнать о менторстве 1:1',
    ctaHref: whatsappMentoring,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'Мини-группы',
    isFeatured: true,
    featuredTag: 'Групповой интенсив',
    title: 'Программа Destrave (Unlock)',
    desc: '8-недельный практический курс для взрослых, кто учил язык, но испытывает ступор при разговоре. Безопасная атмосфера и живая практика.',
    features: [
      '8 живых онлайн-сессий в Zoom',
      '24 коротких видеоурока',
      'Карта интересов и персональный Phrase Bank',
      'Итоговая беседа 1-на-1 с оценкой прогресса'
    ],
    ctaText: 'Подробнее о программе ↗',
    ctaHref: '/ru/destrave'
  },
  {
    tag: 'Дети, подростки и экспаты',
    title: 'Английский для детей (7+)',
    desc: 'Индивидуальные и увлекательные онлайн-уроки для детей от 7 лет. Идеально для семей экспатов и подготовки к международной среде.',
    features: [
      'Игровая и бережная методика без зубрежки и стресса',
      'Развитие уверенной спонтанной разговорной речи',
      'Опыт работы с семьями экспатов (Бразилия, Дубай, мир)',
      '100% живые онлайн-занятия с заботливым педагогом'
    ],
    ctaText: 'Узнать об уроках для детей',
    ctaHref: whatsappKids,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'Для компаний и команд',
    title: 'Корпоративное обучение',
    desc: 'Индивидуальные решения для команд и топ-менеджеров, которым необходима свободная деловая коммуникация на международном уровне.',
    features: [
      'Корпоративная диагностика уровня',
      'Программа под бизнес-процессы компании',
      'Опыт работы с Yamaha, Eaton, Mahle',
      'Отчеты об успеваемости и вовлеченности'
    ],
    ctaText: 'Корпоративные решения',
    ctaHref: whatsappCorporate,
    ctaClass: 'secondary',
    isExternal: true
  }
];

const faqs = [
  {
    q: 'Как персонализация работает на практике?',
    a: 'После стартовой диагностики мы формируем программу вокруг тем, лексики и ситуаций, с которыми вы или ваш ребенок сталкиваетесь каждый день: рабочие митинги, поездки, школа или нетворкинг. Мы не проходим шаблонные учебники страница за страницей.'
  },
  {
    q: 'Для кого созданы программы и уроки NF English?',
    a: 'Мы работаем со взрослыми и специалистами, которым необходимо преодолеть языковой барьер для карьеры и жизни, а также с детьми и подростками (от 7 лет) и семьями экспатов (в Бразилии, Дубае и по всему миру), которым нужно бережное и индивидуальное обучение.'
  },
  {
    q: 'Как устроены занятия для детей (от 7 лет) и семей экспатов за рубежом?',
    a: 'Уроки для детей построены в увлекательной форме через интересные темы, диалоги и интерактивные игры — ребенок начинает говорить уверенно без скучных учебников. Для экспатов в Бразилии (например, во Флорианополисе) или семей в Дубае и Европе все уроки проходят 100% онлайн вживую с удобным расписанием.'
  },
  {
    q: 'В чем разница между Менторством 1:1 и программой Destrave?',
    a: 'Индивидуальное менторство 1:1 — это персональная траектория с гибким расписанием для срочных и специфических задач. Программа Destrave — это 8-недельный групповой онлайн-интенсив в небольших группах для взрослых для преодоления языкового барьера.'
  },
  {
    q: 'Как устроены корпоративные тренинги (In-Company)?',
    a: 'Мы разрабатываем индивидуальные программы для команд и руководителей, интегрируя корпоративные процессы и профессиональную терминологию. Среди наших клиентов — такие бренды, как Yamaha, Eaton и Mahle.'
  },
  {
    q: 'Занятия проходят онлайн или очно?',
    a: 'Все форматы проходят на 100% в живом онлайн-режиме с современными интерактивными материалами и постоянной поддержкой преподавателя, что позволяет учиться из любой точки Бразилии или мира.'
  },
  {
    q: 'С чего начать обучение?',
    a: 'Нажмите на любую кнопку на этой странице, чтобы написать Наталье в WhatsApp. Мы проведем быструю консультацию и подберем наиболее эффективный формат для ваших целей или для вашего ребенка.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Персонализированный английский для взрослых, детей (7+) и компаний" 
  description="Премиальное обучение английскому языку с акцентом на психологический комфорт, преодоление барьеров и 15 лет экспертизы. Индивидуально для взрослых и детей (7+), экспат-семей и компаний."
  lang="ru"
>
  <div class="page" id="top">
    <Header mode="institutional" lang="ru" />
    
    <main>
      <!-- HERO -->
      <Hero
        title="Английский, который адаптируется к вашей жизни, карьере и семье."
        description="Без шаблонных правил и скучных групп. Более 15 лет мы помогаем взрослым и детям от 7 лет превращать пассивные знания в свободную и уверенную речь по индивидуальной методике."
        primaryAction={{ text: 'Обсудить план в WhatsApp', href: whatsappDiagnostic, isExternal: true }}
        secondaryAction={{ text: 'Форматы обучения', href: '#solutions' }}
        microcopy="Дружелюбная и подробная консультация в WhatsApp. Без обязательств."
        pills={['15+ лет опыта', 'Взрослые, подростки & дети (7+)', 'Ученики в Бразилии и за рубежом', 'Индивидуально и в группах']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, основатель NF English"
        floatingNoteTitle="Настоящая персонализация:"
        floatingNoteText="Материалом уроков становится ваша жизнь, интересы и реальные задачи каждого дня."
      />

      <!-- METRICS -->
      <ProofBar
        ariaLabel="Достижения и особенности NF English"
        items={[
          { value: '15+ Лет', label: 'опыта персонализированного и бережного обучения' },
          { value: '100% Под Вас', label: 'стратегия под ваши цели, возраст и ритм жизни' },
          { value: 'Бразилия и мир', label: 'ученики в Дубае, Флорианополисе и странах Европы' },
          { value: 'Упор на речь', label: 'психологический комфорт и уверенность в диалоге' }
        ]}
      />

      <!-- CORPORATE -->
      <div id="corporate">
        <CorporateStrip
          label="Доверие международных лидеров и корпораций:"
          extraBadge="+ Топ-менеджеры"
        />
      </div>

      <!-- COMPARISON -->
      <ComparisonSection
        id="personalization"
        isBand={true}
        eyebrow="Проблема традиционного обучения"
        title="Почему шаблонные курсы не подходят для реальной жизни?"
        description="Большинство традиционных школ обучают всех по одному конвейеру. В результате — разочарование, потерянное время и ложное ощущение, что вам 'не дано'."
        traditionalTitle="Шаблонные школы и приложения"
        traditionalDesc="Жесткая модель, оторванная от индивидуальности:"
        traditionalItems={[
          'Типовые учебники с искусственными диалогами, не имеющими отношения к вашей жизни.',
          'Переполненные группы с разным уровнем, где люди стесняются говорить.',
          'Чрезмерный упор на грамматические правила без практики живой речи.',
          'Строгая критика, которая убивает спонтанность и создает страх ошибки.'
        ]}
        nfTitle="Обучение с реальной персонализацией"
        nfDesc="Методика, которая строится вокруг вас и ваших задач:"
        nfBadge="Преимущество NF English"
        nfItems={[
          'Живой контент: работа, проекты, путешествия, семья или интересы становятся основой уроков.',
          'Психологический комфорт: среда, где ошибки воспринимаются как естественная часть роста.',
          'Мгновенная польза: изучайте выражения, которые применимы в жизни в тот же день.',
          'Внимательное наставничество: поддержка от педагога, понимающего индивидуальные задачи.'
        ]}
      />

      <!-- 4 PILLARS -->
      <PillarsSection
        id="pillars"
        eyebrow="Уникальная методика"
        title="4 столпа персонализированного обучения"
        description="Педагогическая структура, гарантирующая пользу каждой минуты вашего занятия."
        pillars={pillars}
      />

      <!-- SOLUTIONS -->
      <SolutionsSection
        id="solutions"
        isBand={true}
        eyebrow="Форматы обучения"
        title="Подходящий формат для ваших целей и графика"
        description="От индивидуального менторства для взрослых и детей до групповых интенсивов и корпоративных программ."
        solutions={solutions}
      />

      <!-- TEACHER -->
      <TeacherSection
        id="about"
        eyebrow="Основатель & Преподаватель"
        title="Познакомьтесь с Натальей Фернандес"
        description="Более 15 лет Наталья посвятила преподаванию английского языка — помогая как топ-менеджерам и взрослым специалистам преодолевать языковой барьер, так и детям от 7 лет и семьям экспатов с легкостью и радостью говорить на международном языке."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, преподаватель английского языка"
        creds={[
          { value: '15+ Лет', label: 'опыта преподавания и индивидуального наставничества' },
          { value: 'Персонализация', label: 'бережный подход для взрослых, подростков и детей (7+)' },
          { value: 'Глобальный опыт', label: 'ученики в Бразилии, Дубае и международные корпорации' }
        ]}
        manifesto="&ldquo;Свободное владение — это не идеальное произношение без единой ошибки. Это уверенность открыто выражать свои мысли, отстаивать идеи и общаться с миром без страха.&rdquo;"
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        isBand={true}
        eyebrow="Вопросы и ответы"
        title="Часто задаваемые вопросы"
        description="Понятные ответы о методике, форматах и начале обучения."
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="Готовы заговорить на английском по персональному плану?"
        description="Напишите нам в WhatsApp, чтобы задать вопросы, пройти диагностику или подобрать оптимальный формат."
        ctaText="Написать в WhatsApp"
        ctaHref={whatsappDiagnostic}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsappDiagnostic} text="Написать в WhatsApp" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Премиальное персонализированное обучение английскому языку для взрослых, детей (7+), экспат-семей и корпораций. Превращаем знания в уверенную речь."
      solutionsTitle="Программы"
      solutions={[
        { label: 'Индивидуальное менторство 1:1', href: whatsappMentoring, isExternal: true },
        { label: 'Английский для детей (7+)', href: whatsappKids, isExternal: true },
        { label: 'Интенсив Destrave seu Inglês', href: '/ru/destrave' },
        { label: 'Корпоративное обучение', href: whatsappCorporate, isExternal: true },
        { label: 'Методика и столпы', href: '#personalization' }
      ]}
      contactTitle="Контакты"
      contactLinks={[
        { label: 'WhatsApp: +55 (11) 96716-5564', href: 'https://wa.me/5511967165564', isExternal: true },
        { label: 'Наверх', href: '#top' }
      ]}
      copyright={`© ${new Date().getFullYear()} Natalia Fernandes English. Все права защищены.`}
    />
  </div>
</Layout>
