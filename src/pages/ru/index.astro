---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTA from '../../components/MobileCTA.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import CorporateStrip from '../../components/CorporateStrip.astro';
import ComparisonSection from '../../components/ComparisonSection.astro';
import PillarsSection from '../../components/PillarsSection.astro';
import SolutionsSection from '../../components/SolutionsSection.astro';
import TeacherSection from '../../components/TeacherSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';

const msgDiagnostic = 'Здравствуйте, Наталья! Я хочу обсудить индивидуальный план обучения английскому языку.';
const msgMentoring = 'Здравствуйте, Наталья! Меня интересует индивидуальное наставничество 1:1.';
const msgCorporate = 'Здравствуйте, Наталья! Я хочу узнать о корпоративном обучении английскому языку для компании.';

const whatsappDiagnostic = `https://wa.me/5511967165564?text=${encodeURIComponent(msgDiagnostic)}`;
const whatsappMentoring = `https://wa.me/5511967165564?text=${encodeURIComponent(msgMentoring)}`;
const whatsappCorporate = `https://wa.me/5511967165564?text=${encodeURIComponent(msgCorporate)}`;

const pillars = [
  {
    num: '01',
    title: 'Глубокая индивидуальная диагностика',
    desc: 'Перед началом занятий мы детально разбираем ваш предыдущий опыт, психологические барьеры и конкретные карьерные цели, чтобы выстроить точный маршрут.'
  },
  {
    num: '02',
    title: 'Карта интересов и реальная жизнь',
    desc: 'Ваша работа, терминология сферы, переговоры, поездки и личные увлечения становятся основой уроков — никакой абстрактной теории из стандартных учебников.'
  },
  {
    num: '03',
    title: 'Психологический комфорт и поддержка',
    desc: 'Мы создаем безопасную среду, где ошибки воспринимаются как естественный этап роста. Вы начинаете говорить уверенно, без страха критики или неловких пауз.'
  },
  {
    num: '04',
    title: 'Формат для занятых профессионалов',
    desc: 'Гибкая методика с продуманной нагрузкой и практическими микро-заданиями, созданная специально для взрослых с плотным рабочим графиком.'
  }
];

const solutions = [
  {
    tag: 'Индивидуально & Для лидеров',
    title: 'Менторство 1:1',
    desc: 'Персональная программа на 100% под ваши цели: карьерный рост, международные переговоры, собеседования или зарубежные поездки.',
    features: [
      'Индивидуальный учебный план',
      'Отработка реальных рабочих сценариев',
      'Гибкий график занятий',
      'Регулярный фидбек по произношению и беглости'
    ],
    ctaText: 'Узнать о менторстве 1:1',
    ctaHref: whatsappMentoring,
    ctaClass: 'secondary',
    isExternal: true
  },
  {
    tag: 'Мини-группы',
    isFeatured: true,
    featuredTag: 'Групповой интенсив',
    title: 'Программа Destrave (Unlock)',
    desc: '8-недельный практический курс для тех, кто учил язык, но испытывает ступор при разговоре. Безопасная атмосфера и живая практика.',
    features: [
      '8 живых онлайн-сессий в Zoom',
      '24 коротких видеоурока',
      'Карта интересов и персональный Phrase Bank',
      'Итоговая беседа 1-на-1 с оценкой прогресса'
    ],
    ctaText: 'Подробнее о программе ↗',
    ctaHref: '/ru/destrave'
  },
  {
    tag: 'Для компаний и команд',
    title: 'Корпоративное обучение',
    desc: 'Индивидуальные решения для команд и топ-менеджеров, которым необходима свободная деловая коммуникация на международном уровне.',
    features: [
      'Корпоративная диагностика уровня',
      'Программа под бизнес-процессы компании',
      'Опыт работы с Yamaha, Eaton, Mahle',
      'Отчеты об успеваемости и вовлеченности'
    ],
    ctaText: 'Корпоративные решения',
    ctaHref: whatsappCorporate,
    ctaClass: 'secondary',
    isExternal: true
  }
];

const faqs = [
  {
    q: 'Как персонализация работает на практике?',
    a: 'После стартовой диагностики мы формируем программу вокруг тем, лексики и ситуаций, с которыми вы сталкиваетесь каждый день: рабочие митинги, собеседования, поездки или нетворкинг. Мы не проходим шаблонные учебники страница за страницей.'
  },
  {
    q: 'Для кого созданы программы NF English?',
    a: 'Наши программы ориентированы исключительно на взрослых и специалистов: людей, которые уже учили язык ранее или понимают базу, но испытывают трудности в спонтанной речи и хотят обрести уверенность для карьеры и жизни.'
  },
  {
    q: 'В чем разница между Менторством 1:1 и программой Destrave?',
    a: 'Индивидуальное менторство 1:1 — это персональная траектория с гибким расписанием для срочных и специфических задач. Программа Destrave — это 8-недельный групповой онлайн-интенсив в небольших группах для преодоления языкового барьера.'
  },
  {
    q: 'Как устроены корпоративные тренинги (In-Company)?',
    a: 'Мы разрабатываем индивидуальные программы для команд и руководителей, интегрируя корпоративные процессы и профессиональную терминологию. Среди наших клиентов — такие бренды, как Yamaha, Eaton и Mahle.'
  },
  {
    q: 'Занятия проходят онлайн или очно?',
    a: 'Все форматы проходят на 100% в живом онлайн-режиме с современными интерактивными материалами и постоянной поддержкой преподавателя, что позволяет учиться из любой точки мира.'
  },
  {
    q: 'С чего начать обучение?',
    a: 'Нажмите на любую кнопку на этой странице, чтобы написать Наталье в WhatsApp. Мы проведем быструю консультацию и подберем наиболее эффективный формат для ваших целей.'
  }
];
---

<Layout 
  title="Natalia Fernandes English | Персонализированное обучение английскому для взрослых и компаний" 
  description="Премиальное обучение английскому языку с акцентом на преодоление языкового барьера, уверенность в речи и 15 лет экспертизы. Менторство 1:1, группы и корпоративные тренинги."
  lang="ru"
>
  <div class="page" id="top">
    <Header mode="institutional" lang="ru" />
    
    <main>
      <!-- HERO -->
      <Hero
        title="Английский, который адаптируется к вашей жизни, карьере и ритму."
        description="Без шаблонных правил и скучных групп. Более 15 лет мы помогаем взрослым трансформировать пассивные знания в свободную разговорную речь по индивидуальной методике."
        primaryAction={{ text: 'Обсудить план в WhatsApp', href: whatsappDiagnostic, isExternal: true }}
        secondaryAction={{ text: 'Форматы обучения', href: '#solutions' }}
        microcopy="Дружелюбная и подробная консультация в WhatsApp. Без обязательств."
        pills={['15+ лет опыта', '100% для взрослых', 'Корпоративный опыт', 'Индивидуально и в группах']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, основатель NF English"
        floatingNoteTitle="Настоящая персонализация:"
        floatingNoteText="Материалом уроков становится ваша профессия, интересы и реальные задачи каждого дня."
      />

      <!-- METRICS -->
      <ProofBar
        ariaLabel="Достижения и особенности NF English"
        items={[
          { value: '15+ Лет', label: 'профессионального опыта работы со взрослыми' },
          { value: '100% Под Вас', label: 'стратегия обучения под ваши цели и график' },
          { value: 'Корпоративно', label: 'тренинги для международных компаний' },
          { value: 'Упор на речь', label: 'уверенность для реального общения' }
        ]}
      />

      <!-- CORPORATE -->
      <div id="corporate">
        <CorporateStrip
          label="Доверие международных лидеров и корпораций:"
          badges={['YAMAHA', 'EATON', 'MAHLE', '+ Топ-менеджеры']}
        />
      </div>

      <!-- COMPARISON -->
      <ComparisonSection
        id="personalization"
        isBand={true}
        eyebrow="Проблема традиционного обучения"
        title="Почему шаблонные курсы не подходят занятым взрослым?"
        description="Большинство традиционных школ обучают всех по одному конвейеру. В результате — разочарование, потерянное время и ложное ощущение, что вам 'не дано'."
        traditionalTitle="Шаблонные школы и приложения"
        traditionalDesc="Жесткая модель, оторванная от взрослой жизни:"
        traditionalItems={[
          'Типовые учебники с искусственными диалогами, не имеющими отношения к вашей жизни.',
          'Переполненные группы с разным уровнем, где люди стесняются говорить.',
          'Чрезмерный упор на грамматические правила без практики живой речи.',
          'Строгая критика, которая убивает спонтанность и создает страх ошибки.'
        ]}
        nfTitle="Обучение с реальной персонализацией"
        nfDesc="Методика, которая строится вокруг вас и ваших задач:"
        nfBadge="Преимущество NF English"
        nfItems={[
          'Живой контент: ваша работа, проекты, путешествия и интересы становятся основой уроков.',
          'Психологический комфорт: среда, где ошибки воспринимаются как естественная часть роста.',
          'Мгновенная польза: изучайте выражения, которые применимы в работе в тот же день.',
          'Внимательное наставничество: поддержка от педагога, понимающего ритм жизни специалистов.'
        ]}
      />

      <!-- 4 PILLARS -->
      <PillarsSection
        id="pillars"
        eyebrow="Уникальная методика"
        title="4 столпа персонализированного обучения"
        description="Педагогическая структура, гарантирующая пользу каждой минуты вашего занятия."
        pillars={pillars}
      />

      <!-- SOLUTIONS -->
      <SolutionsSection
        id="solutions"
        isBand={true}
        eyebrow="Форматы обучения"
        title="Подходящий формат для ваших целей и графика"
        description="От индивидуального менторства до групповых интенсивов и корпоративного обучения."
        solutions={solutions}
      />

      <!-- TEACHER -->
      <TeacherSection
        id="about"
        eyebrow="Основатель & Преподаватель"
        title="Познакомьтесь с Натальей Фернандес"
        description="Более 15 лет Наталья посвятила преподаванию английского языка взрослым — помогая как специалистам преодолевать языковой барьер, так и топ-менеджерам свободно вести международные переговоры."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, преподаватель английского языка"
        creds={[
          { value: '15+ Лет', label: 'опыта преподавания и менторства' },
          { value: 'Взрослые', label: 'эксперт по снятию языковых барьеров' },
          { value: 'In-Company', label: 'тренинги для лидеров Yamaha, Eaton и Mahle' }
        ]}
        manifesto="&ldquo;Свободное владение — это не идеальное произношение без единой ошибки. Это уверенность открыто выражать свои мысли, отстаивать идеи и общаться с миром без страха.&rdquo;"
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        isBand={true}
        eyebrow="Вопросы и ответы"
        title="Часто задаваемые вопросы"
        description="Понятные ответы о методике, форматах и начале обучения."
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="Готовы заговорить на английском по персональному плану?"
        description="Напишите нам в WhatsApp, чтобы задать вопросы, пройти диагностику или подобрать оптимальный формат."
        ctaText="Написать в WhatsApp"
        ctaHref={whatsappDiagnostic}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsappDiagnostic} text="Написать в WhatsApp" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Премиальное персонализированное обучение английскому языку для взрослых, руководителей и корпораций. Превращаем знания в уверенную речь."
      solutionsTitle="Программы"
      solutions={[
        { label: 'Индивидуальное менторство 1:1', href: whatsappMentoring, isExternal: true },
        { label: 'Интенсив Destrave seu Inglês', href: '/ru/destrave' },
        { label: 'Корпоративное обучение', href: whatsappCorporate, isExternal: true },
        { label: 'Методика и столпы', href: '#personalization' }
      ]}
      contactTitle="Контакты"
      contactLinks={[
        { label: 'WhatsApp: +55 (11) 96716-5564', href: 'https://wa.me/5511967165564', isExternal: true },
        { label: 'Наверх', href: '#top' }
      ]}
      copyright={`© ${new Date().getFullYear()} Natalia Fernandes English. Все права защищены.`}
    />
  </div>
</Layout>
