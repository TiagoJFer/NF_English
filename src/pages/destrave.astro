---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
import Hero from '../components/Hero.astro';
import ProofBar from '../components/ProofBar.astro';
import CardGridSection from '../components/CardGridSection.astro';
import ProgramMethodSection from '../components/ProgramMethodSection.astro';
import TeacherSection from '../components/TeacherSection.astro';
import CurriculumSection from '../components/CurriculumSection.astro';
import OfferSection from '../components/OfferSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABanner from '../components/CTABanner.astro';

const whatsapp = 'https://wa.me/5511967165564?text=Quero%20entrar%20na%20lista%20de%20espera%20do%20Destrave%20seu%20Ingles';

const included = [
  '8 semanas de acompanhamento online.',
  'Aulas ao vivo e conteúdos gravados curtos para vocabulário, frases e listening.',
  'Missões pessoais conectadas aos seus interesses e objetivos.',
  'Mapa de Afinidades para usar sua vida real como material de aula.',
  'Phrase Bank pessoal com expressões úteis para conversas reais.',
  'Conversa final de 10 a 15 minutos, com feedback e próximos passos.'
];

const weeks = [
  { number: '1', title: "I'm back", description: 'Recomeço sem vergonha e frases de sobrevivência.' },
  { number: '2', title: 'Things I like', description: 'Gostos, hobbies, música, séries, comida e esportes.' },
  { number: '3', title: 'My routine', description: 'Rotina real, trabalho, casa, estudos e tempo livre.' },
  { number: '4', title: 'Small talk', description: 'Começar e manter conversas simples sem pânico.' },
  { number: '5', title: 'My stories', description: 'Contar pequenas histórias do passado sem travar.' },
  { number: '6', title: 'Opinions', description: 'Dar opinião, concordar, discordar e explicar preferências.' },
  { number: '7', title: 'Real situations', description: 'Listening e simulações de viagem, trabalho, atendimento ou socialização.' },
  { number: '8', title: 'Final conversation', description: 'Preparação e conversa final de 10 a 15 minutos, com feedback e próximos passos.' }
];

const faqs = [
  {
    q: 'Tenho vergonha de falar. Esse curso é para mim?',
    a: 'Sim. A proposta é criar um ambiente seguro para falar aos poucos, errar sem exposição desnecessária e ganhar confiança.'
  },
  {
    q: 'Já tentei estudar antes e não evoluí. O que muda?',
    a: 'O foco não é acumular mais teoria. Você usa temas da sua vida para praticar fala, escuta e reação em conversas reais.'
  },
  {
    q: 'Meu inglês é muito básico. Posso entrar?',
    a: 'O programa é para quem já teve contato com inglês. Não precisa falar bem, mas é importante reconhecer alguma base do idioma.'
  },
  {
    q: 'Não tenho muito tempo. Vou conseguir acompanhar?',
    a: 'O formato combina aulas gravadas curtas, um encontro semanal e missões simples para manter o inglês presente na rotina.'
  },
  {
    q: 'Vou precisar falar na frente dos outros?',
    a: 'Sim, mas de forma gradual e guiada. A turma existe para praticar, não para expor ou constranger.'
  },
  {
    q: 'O curso promete fluência?',
    a: 'Não. A proposta é construir confiança, repertório e prática para participar de conversas simples e travar menos.'
  },
  {
    q: 'E se eu perceber que não é para mim?',
    a: 'Você conta com garantia de 7 dias. Se o programa não fizer sentido nesse período, pode pedir cancelamento.'
  },
  {
    q: 'Como faço a inscrição?',
    a: 'Clique em um dos botões para chamar no WhatsApp. A equipe confirma a disponibilidade e envia os próximos passos.'
  }
];
---

<Layout 
  title="Destrave seu Inglês | Natalia Fernandes English" 
  description="Programa online de 8 semanas para adultos que já estudaram inglês, mas travam na hora de falar."
>
  <div class="page" id="top">
    <Header mode="destrave" />
    
    <main>
      <!-- HERO -->
      <Hero
        eyebrow="Destrave seu inglês"
        title="Ganhe confiança para conversar em inglês sem travar."
        description="Um programa online para quem já estudou inglês, mas sente que não evoluiu e trava quando precisa falar. Pratique conversas reais usando sua rotina, seus gostos e suas histórias como ponto de partida."
        primaryAction={{ text: 'Quero destravar meu inglês', href: whatsapp, isExternal: true }}
        secondaryAction={{ text: 'Ver turma e investimento', href: '#oferta', isSecondary: true }}
        microcopy="Entre na lista de espera para receber as próximas informações da turma, sem compromisso."
        pills={['8 semanas', 'Aulas ao vivo', 'Vagas limitadas', 'Garantia de 7 dias']}
        imageFrameType="circle"
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Natalia Fernandes, professora de inglês"
        floatingNoteTitle="Você não precisa recomeçar do zero."
        floatingNoteText="O foco é reorganizar o que você já viu e colocar o inglês em uso com segurança."
      />

      <!-- PROOF ROW -->
      <ProofBar
        ariaLabel="Resumo do programa"
        items={[
          { value: '15 anos', label: 'de experiência ensinando inglês' },
          { value: '8', label: 'encontros online ao vivo' },
          { value: '24', label: 'aulas gravadas curtas' },
          { value: '10 a 15 min', label: 'de conversa final para ver sua evolução' }
        ]}
      />

      <!-- DORES / PAIN POINTS -->
      <CardGridSection
        isBand={true}
        title="Se você já estudou e mesmo assim trava, o problema não é falta de capacidade."
        description="Muitas pessoas acumulam regras, listas e aplicativos, mas quase não têm um espaço seguro para falar, errar, ajustar e tentar de novo."
        columns={4}
        items={[
          { icon: '?', title: 'Dá branco na hora', desc: 'Você entende parte da conversa, mas a resposta não sai quando alguém fala com você.' },
          { icon: '!', title: 'Vergonha de errar', desc: 'A preocupação com pronúncia e gramática perfeita trava antes da primeira frase.' },
          { icon: '+', title: 'Já tentou antes', desc: 'Você estudou por meses ou anos, mas sente que não saiu do lugar na conversação.' },
          { icon: '✓', title: 'Pouco tempo', desc: 'Você precisa de um caminho leve e possível na rotina, sem horas livres por dia.' }
        ]}
      />

      <!-- MÉTODO / PROGRAMA -->
      <ProgramMethodSection
        id="programa"
        eyebrow="O programa"
        panelTitle="Destrave seu Inglês"
        panelDescription="Um percurso prático para ganhar confiança em conversas reais, sem prometer fluência milagrosa e sem fazer você começar tudo de novo."
        panelCtaText="Receber detalhes pelo WhatsApp"
        panelCtaHref={whatsapp}
        pillars={[
          { icon: '1', title: 'Sua vida vira assunto', desc: 'Rotina, trabalho, viagens, música, séries, família e histórias pessoais entram nas práticas.' },
          { icon: '2', title: 'Prática segura para falar', desc: 'Você fala aos poucos, com correção leve e sem interrupções que aumentam a vergonha.' },
          { icon: '3', title: 'Evolução possível na rotina', desc: 'Vídeos curtos preparam a aula ao vivo e missões simples mantêm contato com o idioma.' }
        ]}
        includedItems={included}
      />

      <!-- PROFESSORA -->
      <TeacherSection
        id="natalia"
        isBand={true}
        eyebrow="A Professora"
        title="Com Natalia Fernandes, professora de inglês há 15 anos."
        description="A Natalia trabalha com adultos que precisam transformar conhecimento solto em fala possível. A abordagem é próxima, acolhedora e prática, com temas da vida real para reduzir a trava e aumentar a confiança."
        imageSrc="/Nath.jpg"
        imageWebpSrc="/Nath.webp"
        imageAlt="Professora Natalia Fernandes"
        creds={[
          { value: '15', label: 'anos ensinando inglês' },
          { value: 'Adultos', label: 'experiência com alunos que já tentaram antes' },
          { value: 'In company', label: 'aulas para empresas como Yamaha, Eaton e Mahle' }
        ]}
      />

      <!-- JORNADA 8 SEMANAS -->
      <CurriculumSection
        title="Uma jornada de 8 semanas para falar mais e travar menos."
        description="A meta é sair da paralisia e construir repertório para falar sobre rotina, gostos, trabalho, viagens e histórias pessoais."
        steps={weeks}
      />

      <!-- OFERTA & PREÇO -->
      <OfferSection
        id="oferta"
        isBand={true}
        title="Entre na lista de espera."
        description="A próxima turma será anunciada primeiro para quem demonstrar interesse. Entre na lista para receber as informações e entender se o programa faz sentido para você."
        checklist={[
          'Programa online de 8 semanas.',
          'Aulas ao vivo e conteúdos gravados curtos.',
          'Prática baseada na sua rotina e nos seus objetivos.',
          'Turma pequena para manter um ambiente seguro.',
          'Garantia de 7 dias.'
        ]}
        priceAriaLabel="Investimento da condição de lançamento"
        priceLabel="Condição de lançamento"
        price="R$ 497"
        priceDetails="<strong>Condição especial de entrada.</strong>"
        priceFull="Preço cheio nas próximas turmas: R$ 997."
        offerNote="A condição de lançamento será apresentada aos interessados da lista de espera."
        ctaText="Entrar na lista de espera"
        ctaHref={whatsapp}
        ctaMicrocopy="Sem compromisso. Você conversa com a equipe antes de decidir."
      />

      <!-- FAQ -->
      <FAQSection
        id="faq"
        title="Dúvidas comuns"
        faqs={faqs}
      />

      <!-- FINAL CTA -->
      <CTABanner
        title="Você já estudou inglês. Agora é hora de voltar a falar."
        description="Entre na lista de espera do Destrave seu Inglês e receba as informações da próxima turma."
        ctaText="Entrar na lista"
        ctaHref={whatsapp}
      />
    </main>

    <!-- MOBILE CTA -->
    <MobileCTA href={whatsapp} text="Entrar na lista de espera" />

    <!-- FOOTER -->
    <Footer
      brandDescription="Programa online para adultos que querem conversar em inglês com mais confiança."
      solutionsTitle="Navegação"
      solutions={[
        { label: '← Conheça o site institucional', href: '/' }
      ]}
      contactLinks={[
        { label: 'WhatsApp da Equipe', href: whatsapp, isExternal: true },
        { label: 'Voltar ao topo', href: '#top' }
      ]}
    />
  </div>
</Layout>
