---
export interface BrandItem {
  name: string;
  logo?: string;
  alt?: string;
}

interface Props {
  label?: string;
  brands?: BrandItem[];
  badges?: string[];
  extraBadge?: string;
}

const defaultBrands: BrandItem[] = [
  { name: 'Yamaha', logo: '/yamaha.svg', alt: 'Yamaha' },
  { name: 'Eaton', logo: '/eaton.svg', alt: 'Eaton' },
  { name: 'Mahle', logo: '/mahle.svg', alt: 'Mahle' }
];

const {
  label = 'Confiança comprovada por profissionais e grandes corporações:',
  brands = defaultBrands,
  badges,
  extraBadge
} = Astro.props;
---

<div class="corporate-strip">
  <div class="container corporate-inner">
    {label && <span class="corporate-label">{label}</span>}
    <div class="corporate-logos">
      {brands.map((brand) => (
        <div class="corp-logo-item" title={brand.name}>
          {brand.logo ? (
            <img src={brand.logo} alt={brand.alt || brand.name} class="corp-logo-img" loading="lazy" width="120" height="32" />
          ) : (
            <span class="corp-badge">{brand.name}</span>
          )}
        </div>
      ))}
      {extraBadge && (
        <div class="corp-logo-item badge-item">
          <span class="corp-badge">{extraBadge}</span>
        </div>
      )}
      {badges && badges.map((badge) => (
        <div class="corp-logo-item badge-item">
          <span class="corp-badge">{badge}</span>
        </div>
      ))}
    </div>
  </div>
</div>

