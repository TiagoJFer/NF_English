---
import BlogCard from './BlogCard.astro';

interface PostItem {
  slug: string;
  data: {
    title: string;
    hook?: string;
    description?: string;
    category: string;
    readTime: string;
    pubDate: Date | string;
    featured?: boolean;
  };
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  posts: PostItem[];
  ctaText?: string;
  ctaHref?: string;
  isBand?: boolean;
}

const {
  id = 'blog',
  eyebrow = 'Dicas & Artigos',
  title = 'Aprenda a destravar seu inglês com orientações reais',
  description = 'Conteúdos práticos preparados pela Natalia Fernandes para acelerar sua compreensão, eliminar vícios de tradução e destravar sua fala.',
  posts = [],
  ctaText = 'Explorar todos os artigos no Blog',
  ctaHref = '/blog',
  isBand = false
} = Astro.props;
---

<section id={id} class={`blog-section ${isBand ? 'band' : ''}`}>
  <div class="container">
    <div class="section-head">
      {eyebrow && (
        <div class="eyebrow sage">
          <span class="dot"></span> {eyebrow}
        </div>
      )}
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>

    <div class="blog-grid">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          hook={post.data.hook}
          description={post.data.description}
          category={post.data.category}
          readTime={post.data.readTime}
          pubDate={post.data.pubDate}
          slug={post.slug}
          featured={post.data.featured}
        />
      ))}
    </div>

    {ctaHref && (
      <div class="blog-section-cta">
        <a href={ctaHref} class="btn secondary">
          {ctaText} <span>→</span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .blog-section {
    padding: 90px 0;
    position: relative;
  }

  .blog-section.band {
    background: var(--surface-soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 24px;
    margin-top: 36px;
    align-items: stretch;
  }

  .blog-section-cta {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 768px) {
    .blog-section {
      padding: 60px 0;
    }
    
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
