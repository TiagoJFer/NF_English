---
interface Props {
  mode?: 'institutional' | 'destrave' | 'index';
  lang?: 'pt' | 'en' | 'ru';
}

const { mode = 'institutional', lang = 'pt' } = Astro.props;

const isInstitutional = mode === 'institutional' || mode === 'index';
const isEn = lang === 'en';
const isRu = lang === 'ru';
const isPt = !isEn && !isRu;

// WhatsApp links
const msgInstrucional = isRu
  ? 'Здравствуйте, Наталья! Я хочу обсудить индивидуальный план обучения английскому языку.'
  : isEn
  ? 'Hi Natalia, I would like to learn more about your customized English programs.'
  : 'Ola Natalia, gostaria de conversar sobre um plano personalizado de ingles.';

const msgDestrave = isRu
  ? 'Здравствуйте, Наталья! Я хочу записаться в лист ожидания программы Destrave seu Inglês.'
  : isEn
  ? 'Hi Natalia, I would like to join the Unlock Your English waiting list.'
  : 'Quero entrar na lista de espera do Destrave seu Ingles';

const whatsappInstitucional = `https://wa.me/5511967165564?text=${encodeURIComponent(msgInstrucional)}`;
const whatsappDestrave = `https://wa.me/5511967165564?text=${encodeURIComponent(msgDestrave)}`;

const activeWhatsapp = isInstitutional ? whatsappInstitucional : whatsappDestrave;
const ctaText = isInstitutional
  ? (isRu ? 'В WhatsApp' : isEn ? 'WhatsApp Chat' : 'Falar no WhatsApp')
  : (isRu ? 'В лист ожидания' : isEn ? 'Join Waitlist' : 'Entrar na lista');

// Target URLs for language switcher
const ptTarget = isInstitutional ? '/' : '/destrave';
const enTarget = isInstitutional ? '/en' : '/en/destrave';
const ruTarget = isInstitutional ? '/ru' : '/ru/destrave';
const homeTarget = isRu ? '/ru' : isEn ? '/en' : '/';
const destraveTarget = isRu ? '/ru/destrave' : isEn ? '/en/destrave' : '/destrave';

// Section anchor links based on current language and mode
const linkPersonalization = isRu ? '/ru#personalization' : isEn ? '/en#personalization' : '/#personalizacao';
const linkSolutions = isRu ? '/ru#solutions' : isEn ? '/en#solutions' : '/#solucoes';
const linkAbout = isRu ? '/ru#about' : isEn ? '/en#about' : '/#sobre';
const linkCorporate = isRu ? '/ru#corporate' : isEn ? '/en#corporate' : '/#corporate';
const linkFaq = isInstitutional
  ? (isRu ? '/ru#faq' : isEn ? '/en#faq' : '/#faq')
  : (isRu ? '/ru/destrave#faq' : isEn ? '/en/destrave#faq' : '/destrave#faq');

const linkProgram = isRu ? '/ru/destrave#program' : isEn ? '/en/destrave#program' : '/destrave#programa';
const linkTeacher = isRu ? '/ru/destrave#natalia' : isEn ? '/en/destrave#natalia' : '/destrave#natalia';
const linkOffer = isRu ? '/ru/destrave#offer' : isEn ? '/en/destrave#offer' : '/destrave#oferta';
