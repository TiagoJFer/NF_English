---
interface ActionButton {
  text: string;
  href: string;
  isSecondary?: boolean;
  isGold?: boolean;
  isExternal?: boolean;
}

interface AnnouncementBanner {
  tag?: string;
  strong?: string;
  text: string;
  linkText?: string;
  linkHref?: string;
}

interface Props {
  eyebrow?: string;
  highlightTag?: string;
  announcement?: AnnouncementBanner;
  variant?: 'default' | 'destrave';
  title: string;
  description: string;
  primaryAction?: ActionButton;
  secondaryAction?: ActionButton;
  microcopy?: string;
  pills?: string[];
  imageSrc?: string;
  imageWebpSrc?: string;
  imageAlt?: string;
  imageFrameType?: 'circle' | 'portrait';
  floatingNoteTitle?: string;
  floatingNoteText?: string;
}

const {
  eyebrow,
  highlightTag,
  announcement,
  variant = 'default',
  title,
  description,
  primaryAction,
  secondaryAction,
  microcopy,
  pills = [],
  imageSrc = '/Nath.jpg',
  imageWebpSrc = '/Nath.webp',
  imageAlt = 'Natalia Fernandes, professora de inglês',
  imageFrameType = 'circle',
  floatingNoteTitle,
  floatingNoteText
} = Astro.props;

const isDestrave = variant === 'destrave';
---

<section class={`hero ${isDestrave ? 'hero-destrave' : ''} ${announcement ? 'has-announcement' : ''}`}>
  {isDestrave && <div class="hero-destrave-glow" aria-hidden="true" />}

  {announcement && (
    <div class="hero-announcement-strip">
      <div class="container hero-announcement-inner">
        <div class="announcement-left">
          {announcement.tag && <span class="announcement-badge">{announcement.tag}</span>}
          <div class="announcement-text">
            {announcement.strong && <strong>{announcement.strong} </strong>}
            <span set:html={announcement.text} />
          </div>
        </div>
        {announcement.linkText && (
          <a href={announcement.linkHref || '#oferta'} class="announcement-link">
            {announcement.linkText} <span class="arr">→</span>
          </a>
        )}
      </div>
    </div>
  )}

  <div class="container hero-grid">
    <div class="hero-content">
      {highlightTag && (
        <div class="destrave-highlight-badge">
          <span class="badge-icon">👥</span>
          <span>{highlightTag}</span>
        </div>
      )}

      {eyebrow && !highlightTag && (
        <div class="eyebrow"><span class="dot"></span> {eyebrow}</div>
      )}
      
      <h1 class="hero-title" set:html={title} />

      <div class="hero-mobile-media">
        {imageFrameType === 'circle' ? (
          <div class="hero-image-wrapper">
            <div class="hero-circle-frame">
              <picture>
                {imageWebpSrc && <source srcset={imageWebpSrc} type="image/webp" />}
                <img
                  src={imageSrc}
                  alt={imageAlt}
                  width="440"
                  height="440"
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                />
              </picture>
            </div>
            {(floatingNoteTitle || floatingNoteText) && (
              <div class="floating-note">
                {floatingNoteTitle && <strong>{floatingNoteTitle}</strong>}
                {floatingNoteText && <p>{floatingNoteText}</p>}
              </div>
            )}
          </div>
        ) : (
          <div class="portrait-frame">
            <picture>
              {imageWebpSrc && <source srcset={imageWebpSrc} type="image/webp" />}
              <img
                src={imageSrc}
                alt={imageAlt}
                width="440"
                height="560"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
            </picture>
            {(floatingNoteTitle || floatingNoteText) && (
              <div class="floating-note">
                {floatingNoteTitle && <strong>{floatingNoteTitle}</strong>}
                {floatingNoteText && <p>{floatingNoteText}</p>}
              </div>
            )}
          </div>
        )}
      </div>

      <p class="hero-copy" set:html={description} />

      {(primaryAction || secondaryAction) && (
        <div class={`hero-actions ${primaryAction && secondaryAction ? 'has-both-actions' : ''}`}>
          {primaryAction && (
            <a
              class={`button hero-primary ${primaryAction.isGold ? 'gold' : ''} ${primaryAction.isSecondary ? 'secondary' : ''}`}
              href={primaryAction.href}
              target={primaryAction.isExternal ? '_blank' : undefined}
              rel={primaryAction.isExternal ? 'noreferrer' : undefined}
            >
              {primaryAction.text}
            </a>
          )}
          {secondaryAction && (
            <a
              class={`button hero-secondary ${secondaryAction.isSecondary ? 'secondary' : ''}`}
              href={secondaryAction.href}
              target={secondaryAction.isExternal ? '_blank' : undefined}
              rel={secondaryAction.isExternal ? 'noreferrer' : undefined}
            >
              {secondaryAction.text}
            </a>
          )}
        </div>
      )}

      {microcopy && <p class="microcopy">{microcopy}</p>}

      {pills.length > 0 && (
        <div class="hero-proof">
          {pills.map((pill) => (
            <span class="pill">{pill}</span>
          ))}
        </div>
      )}
    </div>

    <div class="hero-desktop-media">
      {imageFrameType === 'circle' ? (
        <div class="hero-image-wrapper">
          <div class="hero-circle-frame">
            <picture>
              {imageWebpSrc && <source srcset={imageWebpSrc} type="image/webp" />}
              <img
                src={imageSrc}
                alt={imageAlt}
                width="576"
                height="1024"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>
          {(floatingNoteTitle || floatingNoteText) && (
            <div class="floating-note">
              {floatingNoteTitle && <strong>{floatingNoteTitle}</strong>}
              {floatingNoteText && <p>{floatingNoteText}</p>}
            </div>
          )}
        </div>
      ) : (
        <div class="portrait-frame">
          <picture>
            {imageWebpSrc && <source srcset={imageWebpSrc} type="image/webp" />}
            <img
              src={imageSrc}
              alt={imageAlt}
              width="576"
              height="1024"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </picture>
          {(floatingNoteTitle || floatingNoteText) && (
            <div class="floating-note">
              {floatingNoteTitle && <strong>{floatingNoteTitle}</strong>}
              {floatingNoteText && <p>{floatingNoteText}</p>}
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</section>
